---
const stats = [
  { value: '2+', label: 'Proyectos desplegados', subtitle: 'y contando' },
  { value: '100/100', label: 'Lighthouse Score', subtitle: 'rendimiento perfecto' },
  { value: '0', label: 'Sitios hackeados', subtitle: 'arquitectura inmune' },
  { value: '3', label: 'Paises alcanzados', subtitle: 'Venezuela, Colombia, Chile' },
]
---

<section class="border-t border-cry-border/30 px-6 py-20">
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {stats.map((s) => (
        <div class="rounded-lg border border-cry-border/30 bg-cry-card/40 p-5 text-center transition-all hover:border-cry-lime/20 hover:bg-cry-lime/[0.02]">
          <div class="font-mono text-3xl font-black text-cry-lime sm:text-4xl">{s.value}</div>
          <div class="mt-1 text-sm font-medium text-cry-text">{s.label}</div>
          <div class="mt-0.5 text-xs text-cry-muted/50">{s.subtitle}</div>
        </div>
      ))}
    </div>
  </div>
</section>
