---
const r = {
  name: "Pizza Roma",
  tagline: "La tradizione italiana en cada rebanada",
  slogan: "Masa madre, horno de leña y los mejores ingredientes desde 2015",
  wa: "584200000000",
  address: "Calle Bolívar, Centro Comercial Los Andes, Local 5",
  schedule: "Lun-Sáb: 11:00 - 23:00 | Dom: 12:00 - 21:00",
  ig: "@pizzaroma",
  fb: "pizzaroma",
  x: "@pizzaroma",
}

const config = {
  defaultCurrency: 'usd',
  bsRate: 52.50,
  ivaOn: true,
}

const unsplash = (id, w=600) =>
  `https://images.unsplash.com/${id}?w=${w}&auto=format&fm=webp`

const menu = [
  { cat: "Pizzas Clásicas", items: [
    { n: "Margherita", d: "Tomate, mozzarella fresca, albahaca", p: 8.99, img: unsplash("photo-1565299624946-b28f40a0ae38"), hasExtras: true },
    { n: "Pepperoni", d: "Pepperoni, mozzarella, salsa de tomate", p: 9.99, img: unsplash("photo-1628840042765-356cda07504e"), hasExtras: true },
    { n: "Napolitana", d: "Anchoas, aceitunas, alcaparras, mozzarella", p: 10.99, img: unsplash("photo-1778449068450-cf13d3d133c4"), hasExtras: true },
    { n: "Mozzarella", d: "Mozzarella, orégano, salsa de tomate", p: 7.99, img: unsplash("photo-1513104890138-7c749659a591"), hasExtras: true },
  ]},
  { cat: "Pizzas Especiales", items: [
    { n: "Hawaiana", d: "Jamón, piña, mozzarella", p: 11.99, img: unsplash("photo-1658124927538-fb804bc5fc9f"), hasExtras: true },
    { n: "BBQ Chicken", d: "Pollo BBQ, cebolla morada, mozzarella", p: 12.99, img: unsplash("photo-1767065603116-8cee3bf11372"), hasExtras: true },
    { n: "Vegetariana", d: "Champiñones, pimientos, aceitunas, cebolla", p: 10.99, img: unsplash("photo-1646129618447-4d116bfd69ab"), hasExtras: true },
    { n: "Mexicana", d: "Chorizo, jalapeño, pimientos, mozzarella", p: 12.99, img: unsplash("photo-1551504734-5ee1c4a1479b"), hasExtras: true },
  ]},
  { cat: "Bebidas", items: [
    { n: "Coca-Cola", d: "Lata 355ml bien fría", p: 1.50, img: unsplash("photo-1554866585-cd94860890b7"), hasExtras: false },
    { n: "Sprite", d: "Lata 355ml", p: 1.50, img: unsplash("photo-1554310636-9eef29dea2fa"), hasExtras: false },
    { n: "Agua Mineral", d: "Botella 500ml", p: 1.00, img: unsplash("photo-1546924282-0f057bc9dd5a"), hasExtras: false },
    { n: "Cerveza Polar", d: "Lata 355ml helada", p: 2.00, img: unsplash("photo-1651421479146-247cdaf0eaad"), hasExtras: false },
  ]},
  { cat: "Postres", items: [
    { n: "Tiramisú", d: "Clásico italiano con mascarpone y cacao", p: 5.00, img: unsplash("photo-1571877227200-a0d98ea607e9"), hasExtras: false },
    { n: "Cannoli", d: "Relleno de ricotta y chispas de chocolate", p: 4.50, img: unsplash("photo-1551024601-bec78aea704b"), hasExtras: false },
    { n: "Panna Cotta", d: "Con frutos rojos y reducción de balsámico", p: 5.00, img: unsplash("photo-1488477181946-6428a0291777"), hasExtras: false },
  ]},
]
---

<section id="gastro-content" class="min-h-screen bg-white text-gray-900 font-sans overflow-x-hidden">
  <!-- Nav -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-gray-200 bg-white/90 backdrop-blur-lg">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="#" class="flex items-center gap-2 font-mono text-lg font-bold tracking-wider text-red-600">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <path d="M12 3 L21 19 Q12 22 3 19 Z" />
          <path d="M3 19 Q12 22 21 19" stroke-width="2.5" stroke-linecap="round" />
          <path d="M12 3 Q13 7 11 9" stroke-width="1.2" stroke-linecap="round" />
          <circle cx="10" cy="13" r="2" stroke-width="1" />
          <circle cx="15" cy="15" r="1.8" stroke-width="1" />
          <circle cx="8" cy="17.5" r="1.5" stroke-width="1" />
          <circle cx="13.5" cy="11" r="1.3" stroke-width="1" />
        </svg>
        ROMA
      </a>
      <div class="flex items-center gap-6">
        <a href="#menu" class="hidden text-sm text-gray-600 transition-colors hover:text-red-600 sm:block">Pizzas</a>
        <a href="#resenas" class="hidden text-sm text-gray-600 transition-colors hover:text-red-600 sm:block">Reseñas</a>
        <button id="open-cart-btn" class="relative flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-600 transition-all hover:bg-red-100">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
          </svg>
          <span id="nav-cart-count" class="hidden rounded-full bg-red-600 px-1.5 py-0.5 text-[10px] font-bold text-white">0</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative flex min-h-screen items-center overflow-hidden px-6 pt-24">
    <div class="pointer-events-none absolute inset-0 bg-checkered">
      <div class="absolute top-1/4 left-1/4 h-96 w-96 rounded-full bg-red-100 blur-[150px]"></div>
      <div class="absolute bottom-1/4 right-1/4 h-96 w-96 rounded-full bg-red-50 blur-[150px]"></div>
    </div>
    <div class="hero-content relative z-10 mx-auto flex w-full max-w-6xl flex-col items-center gap-16 lg:flex-row">
      <div class="flex-1 text-center lg:text-left">
        <div class="hero-badge mb-6 inline-block rounded-full border border-red-200 bg-red-50 px-4 py-1.5 font-mono text-[11px] text-red-600 uppercase tracking-[0.2em] font-semibold">Horno de leña desde 2015</div>
        <h1 class="hero-title mb-4 text-5xl font-black leading-tight tracking-tight sm:text-6xl md:text-7xl lg:text-8xl text-gray-900">
          LA <span class="text-red-600">PIZZA</span><br/>PERFECTA
        </h1>
        <p class="hero-subtitle mb-2 text-xl text-gray-600 sm:text-2xl">{r.tagline}</p>
        <p class="hero-desc mb-8 text-sm text-gray-600">{r.slogan}</p>
        <div class="hero-cta flex flex-col items-center gap-4 sm:flex-row lg:justify-start">
          <a href="#menu" class="group inline-flex items-center gap-2 rounded-lg bg-red-600 px-8 py-4 font-mono text-sm font-bold text-white shadow-lg shadow-red-200 transition-all hover:bg-red-700">
            <span>VER PIZZAS</span>
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href={"https://wa.me/" + r.wa} target="_blank" class="font-mono text-xs text-gray-600 underline underline-offset-4 decoration-gray-300 transition-colors hover:text-red-600">Pedir por WhatsApp</a>
        </div>
      </div>
      <div class="hero-image flex-1">
        <div class="relative mx-auto h-80 w-80 sm:h-96 sm:w-96">
          <div class="hero-pizza-glow absolute inset-0 rounded-full bg-red-100 blur-2xl"></div>
          <div class="relative flex h-full w-full items-center justify-center rounded-full border-2 border-red-100 bg-gradient-to-br from-red-50 via-white to-white">
            <svg class="hero-pizza-svg h-48 w-48 text-red-500/60" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
              <path d="M50 8 L86 78 Q50 92 14 78 Z" stroke-width="1.5" />
              <path d="M14 78 Q50 92 86 78" stroke-width="3" stroke-linecap="round" />
              <path d="M50 8 Q52 16 48 20" stroke-width="1.5" stroke-linecap="round" />
              <circle cx="44" cy="52" r="4.5" stroke-width="1.5" />
              <circle cx="64" cy="60" r="4" stroke-width="1.5" />
              <circle cx="32" cy="66" r="3.5" stroke-width="1.5" />
              <circle cx="56" cy="44" r="3" stroke-width="1.5" />
              <circle cx="38" cy="44" r="2.5" stroke-width="1.5" />
              <circle cx="66" cy="70" r="3" stroke-width="1.5" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Detail Modal -->
  <div id="detail-modal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-black/30 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Detalle del producto">
    <div class="mx-4 w-full max-w-lg rounded-2xl border border-gray-200 bg-white shadow-2xl shadow-gray-200/80 overflow-hidden">
      <div class="relative h-64 sm:h-72 bg-gray-100">
        <img id="modal-img" src="" alt="" class="js-zoom h-full w-full cursor-pointer object-cover" />
      </div>
      <div class="px-6 py-5">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h3 id="modal-name" class="font-mono text-xl font-bold text-gray-900 truncate"></h3>
            <p id="modal-desc" class="mt-1 text-sm text-gray-600"></p>
          </div>
          <p id="modal-price" class="font-mono text-lg font-bold text-red-600 flex-shrink-0"></p>
        </div>
        <div id="toppings-section" class="mt-5">
          <p class="mb-3 font-mono text-xs font-bold text-gray-700 uppercase tracking-widest">Extras</p>
          <div id="topping-list" class="grid grid-cols-2 gap-2"></div>
        </div>
        <div id="qty-section" class="mt-5 hidden">
          <p class="mb-3 font-mono text-xs font-bold text-gray-700 uppercase tracking-widest">Cantidad</p>
          <div class="flex items-center gap-4">
            <button id="modal-qty-down" class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-300 text-gray-600 transition-all hover:border-red-300 hover:text-red-600 text-lg font-bold select-none" aria-label="Disminuir cantidad">-</button>
            <span id="modal-qty" class="font-mono text-2xl font-bold text-gray-900 min-w-[2rem] text-center">1</span>
            <button id="modal-qty-up" class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-300 text-gray-600 transition-all hover:border-red-300 hover:text-red-600 text-lg font-bold select-none" aria-label="Aumentar cantidad">+</button>
          </div>
        </div>
        <div class="mt-5 flex items-center justify-between border-t border-gray-100 pt-4">
          <div>
            <span class="font-mono text-xs text-gray-600">Total</span>
            <p id="modal-total" class="font-mono text-2xl font-bold text-gray-900"></p>
          </div>
          <div class="flex gap-2">
            <button id="modal-cancel" class="rounded-lg border border-gray-300 px-5 py-2.5 font-mono text-xs text-gray-600 transition-all hover:border-gray-400 hover:text-gray-900">Cancelar</button>
            <button id="modal-confirm" class="rounded-lg bg-red-600 px-5 py-2.5 font-mono text-xs font-bold text-white transition-all hover:bg-red-700">Agregar al carrito</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Image Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[70] hidden flex items-center justify-center bg-black/80 backdrop-blur-sm cursor-pointer" role="dialog" aria-modal="true" aria-label="Vista ampliada de la imagen">
    <button id="lightbox-close" class="absolute top-4 right-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/20 text-white transition-all hover:bg-white/30">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] rounded-xl object-contain shadow-2xl cursor-default" />
  </div>

  <!-- Italian Flag Divider -->
  <div class="flex h-1.5">
    <div class="h-full w-1/3 bg-green-600"></div>
    <div class="h-full w-1/3 bg-white border-x border-gray-200"></div>
    <div class="h-full w-1/3 bg-red-600"></div>
  </div>

  <!-- Menu -->
  <section id="menu" class="relative px-6 py-32">
    <div class="mx-auto max-w-5xl">
      <div class="mb-4 text-center font-mono text-[11px] text-red-500 uppercase tracking-[0.2em] font-semibold">// nuestro menú</div>
      <h2 class="mb-4 text-center text-4xl font-black tracking-tight sm:text-5xl text-gray-900">PIZZAS QUE <span class="text-red-600">ENAMORAN</span></h2>
      <p class="mb-16 text-center text-sm text-gray-600">Elegí tu pizza y agregale los toppings que quieras</p>
      {menu.map((section, si) => (
        <div class="menu-section mb-16">
          <div class="menu-cat mb-8 flex items-center gap-4">
            <div class="h-px flex-1 bg-gradient-to-r from-gray-200 to-transparent"></div>
            <span class="font-mono text-base font-bold text-gray-700 uppercase tracking-widest">{section.cat}</span>
            <div class="h-px flex-1 bg-gradient-to-l from-gray-200 to-transparent"></div>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            {section.items.map((item) => (
              <button
                class="menu-item group relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 text-left transition-all duration-300 hover:border-red-200 hover:shadow-lg hover:shadow-red-100/50"
                data-name={item.n}
                data-price={item.p.toFixed(2)}
                data-img={item.img}
                data-desc={item.d}
                data-has-extras={item.hasExtras}
              >
                <div class="relative z-10 flex items-center gap-5">
                  <img
                    src={item.img}
                    alt={item.n}
                    loading="lazy"
                    width="112"
                    height="112"
                    class="js-zoom h-28 w-28 flex-shrink-0 cursor-pointer rounded-xl border border-gray-100 bg-gray-50 object-cover transition-transform duration-200 hover:scale-105"
                    onerror="this.style.display='none'"
                  />
                  <div class="flex flex-1 flex-col justify-between min-h-[7rem]">
                    <div>
                      <span class="font-mono text-base font-bold text-gray-900 transition-colors group-hover:text-red-600 truncate block">{item.n}</span>
                      <p class="mt-1 text-sm text-gray-600 leading-relaxed line-clamp-2">{item.d}</p>
                    </div>
                    <div class="mt-auto flex items-center justify-between gap-2">
                      <div>
                        <div class="font-mono text-lg font-bold text-red-600">$ {item.p.toFixed(2)}</div>
                        <div class="js-bs-price font-mono text-xs text-gray-600 hidden">Bs. --</div>
                      </div>
                      <div class="js-add-direct flex h-9 w-9 flex-shrink-0 cursor-pointer items-center justify-center rounded-full bg-red-600 text-white text-sm font-bold transition-all hover:bg-red-700 active:scale-90 shadow-sm" aria-label="Agregar directo">
                        <svg class="h-4 w-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                      </div>
                    </div>
                  </div>
                </div>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Cart Floating -->
  <div id="cart-floating" class="fixed bottom-4 right-4 z-50 hidden w-80 translate-y-4 rounded-xl border border-gray-200 bg-white shadow-2xl shadow-gray-200/80 backdrop-blur-md opacity-0">
    <div class="flex items-center justify-between border-b border-gray-100 px-4 py-3">
      <div>
        <h3 class="font-mono text-sm font-bold text-gray-900">TU PEDIDO</h3>
        <p id="cart-item-count" class="font-mono text-xs text-gray-600">0 items</p>
      </div>
      <button id="close-cart-btn" class="flex h-6 w-6 items-center justify-center rounded-full border border-gray-300 text-xs text-gray-600 transition-all hover:border-gray-400 hover:text-gray-700">
        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="cart-items" class="max-h-[18rem] overflow-y-auto px-4 py-3">
      <div id="cart-empty" class="flex flex-col items-center justify-center py-8 text-center">
        <p class="font-mono text-sm text-gray-600">Tu carrito está vacío</p>
        <p class="mt-1 font-mono text-xs text-gray-600">Agregá pizzas del menú</p>
      </div>
      <div id="cart-list" class="hidden space-y-2"></div>
    </div>
    <div id="cart-footer" class="hidden border-t border-gray-100 px-4 py-3">
      <div class="mb-3 space-y-1.5">
        <div class="flex items-center justify-between font-mono text-sm"><span class="text-gray-600">Subtotal</span><span id="cart-subtotal" class="text-gray-900 font-semibold">$0.00</span></div>
        <div id="cart-tax-row" class="flex items-center justify-between font-mono text-sm"><span class="text-gray-600">IVA (16%)</span><span id="cart-tax" class="text-gray-600">$0.00</span></div>
        <div class="border-t border-gray-100 pt-1.5"></div>
        <div class="flex items-center justify-between font-mono text-base font-bold"><span class="text-gray-900">Total</span><span id="cart-total" class="text-red-600">$0.00</span></div>
      </div>
      <div id="currency-switch" class="relative mb-3 flex cursor-pointer rounded-lg border border-gray-200 bg-gray-100 p-0.5 select-none overflow-hidden">
        <div id="curr-slider" class="absolute top-0.5 bottom-0.5 w-1/2 rounded-md bg-white shadow-sm transition-transform duration-200 ease-out"></div>
        <span class="relative z-10 flex-1 px-3 py-1.5 text-center font-mono text-xs font-bold" data-curr="usd">$ USD</span>
        <span class="relative z-10 flex-1 px-3 py-1.5 text-center font-mono text-xs font-bold" data-curr="bs">Bs.</span>
      </div>
      <div id="pay-methods" class="mb-2 flex flex-nowrap gap-1 overflow-x-auto"></div>
      <a id="cart-wa-btn" href={"https://wa.me/" + r.wa + "?text="} target="_blank" class="flex w-full items-center justify-center gap-2 rounded-lg bg-red-600 px-4 py-2.5 font-mono text-sm font-bold text-white transition-all hover:bg-red-700">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>



  <!-- Toast -->
  <div id="toast" class="fixed top-24 right-6 z-50 hidden translate-x-full rounded-lg border border-green-200 bg-white px-5 py-3 shadow-lg shadow-green-100/50 backdrop-blur-md">
    <div class="flex items-center gap-3">
      <svg class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div><p id="toast-msg" class="font-mono text-sm text-gray-800">Item agregado</p></div>
    </div>
  </div>

  <!-- Italian Flag Divider -->
  <div class="flex h-1.5">
    <div class="h-full w-1/3 bg-green-600"></div>
    <div class="h-full w-1/3 bg-white border-x border-gray-200"></div>
    <div class="h-full w-1/3 bg-red-600"></div>
  </div>

  <!-- Reviews -->
  <section id="resenas" class="border-t border-gray-100 bg-gray-50/50 px-6 py-32">
    <div class="mx-auto max-w-4xl">
      <div class="mb-4 text-center font-mono text-[11px] text-red-500 uppercase tracking-[0.2em] font-semibold">// reseñas</div>
      <h2 class="mb-16 text-center text-4xl font-black tracking-tight sm:text-5xl text-gray-900">LO QUE DICEN <span class="text-red-600">NUESTROS COMENSALES</span></h2>
      <div class="grid gap-6 md:grid-cols-3">
        {[0,1,2].map((i) => {
          const reviews = [
            { name: "María G.", text: "La Margherita es idéntica a la de Nápoles. La masa es espectacular.", rating: 5 },
            { name: "Carlos L.", text: "Las pizzas especiales son increíbles. La BBQ Chicken es mi favorita.", rating: 5 },
