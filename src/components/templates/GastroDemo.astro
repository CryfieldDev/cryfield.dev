<script>
  import gsap from 'gsap'

  const BS_RATE = 52.50
  const DEFAULT_CURRENCY = 'usd'
  const IVA_ON = true
  const PAY_METHODS = {
    usd: ['Zelle', 'Efectivo USD', 'USDT', 'PayPal'],
    bs: ['Pago móvil', 'Transferencia'],
  }

  const TOPPINGS = [
    { n: 'Queso extra', p: 1.50 },
    { n: 'Pepperoni', p: 1.00 },
    { n: 'Champiñones', p: 1.00 },
    { n: 'Aceitunas', p: 0.75 },
    { n: 'Cebolla', p: 0.75 },
    { n: 'Pimientos', p: 0.75 },
    { n: 'Jamón', p: 1.50 },
    { n: 'Anchoas', p: 2.00 },
  ]

  const state = {
    items: [],
    apiRate: null,
    currency: DEFAULT_CURRENCY,
    payment: null,
    modalItem: null,
    modalToppings: [],
    modalQty: 1,
    modalHasExtras: false,
  }

  async function fetchRate() {
    try {
      const res = await fetch('https://ve.dolarapi.com/v1/dolares/oficial')
      const data = await res.json()
      state.apiRate = data.promedio
    } catch (e) {
      console.warn('Failed to fetch rate')
    }
  }

  function applyRateToMenu() {
    const rate = state.apiRate || (BS_RATE > 0 ? BS_RATE : 0)
    document.querySelectorAll('.menu-item').forEach(btn => {
      const priceUsd = parseFloat(btn.dataset.price)
      const bsPriceEl = btn.querySelector('.js-bs-price')
      if (bsPriceEl && rate > 0) {
        const bs = priceUsd * rate
        bsPriceEl.textContent = 'Bs. ' + bs.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        bsPriceEl.classList.remove('hidden')
      }
    })
  }

  function getRate() {
    if (state.currency === 'usd') return 1
    return state.apiRate || (BS_RATE > 0 ? BS_RATE : 1)
  }

  function convert(usdPrice) { return usdPrice * getRate() }

  function formatPrice(val) {
    if (state.currency === 'usd') return '$ ' + val.toFixed(2)
    return 'Bs. ' + val.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
  }

  gsap.timeline({ defaults: { ease: 'power3.out' } })
    .from('.hero-badge', { y: 20, opacity: 0, duration: 0.5 })
    .from('.hero-title', { y: 40, opacity: 0, duration: 0.7 }, '-=0.2')
    .from('.hero-subtitle', { y: 30, opacity: 0, duration: 0.6 }, '-=0.4')
    .from('.hero-desc', { y: 20, opacity: 0, duration: 0.5 }, '-=0.3')
    .from('.hero-cta', { y: 20, opacity: 0, duration: 0.5 }, '-=0.2')
    .from('.hero-image', { scale: 0.8, opacity: 0, duration: 0.8 }, '-=0.6')

  const cartFloating = document.getElementById('cart-floating')
  const openBtn = document.getElementById('open-cart-btn')
  const closeBtn = document.getElementById('close-cart-btn')
  const cartEmpty = document.getElementById('cart-empty')
  const cartList = document.getElementById('cart-list')
  const cartFooter = document.getElementById('cart-footer')
  const cartSubtotal = document.getElementById('cart-subtotal')
  const cartTax = document.getElementById('cart-tax')
  const cartTaxRow = document.getElementById('cart-tax-row')
  const cartTotal = document.getElementById('cart-total')
  const cartItemCount = document.getElementById('cart-item-count')
  const navCartCount = document.getElementById('nav-cart-count')
  const toast = document.getElementById('toast')
  const toastMsg = document.getElementById('toast-msg')
  const cartWaBtn = document.getElementById('cart-wa-btn')
  const payMethodsEl = document.getElementById('pay-methods')
  const modal = document.getElementById('detail-modal')
  const modalImg = document.getElementById('modal-img')
  const modalName = document.getElementById('modal-name')
  const modalDesc = document.getElementById('modal-desc')
  const modalPrice = document.getElementById('modal-price')
  const modalTotal = document.getElementById('modal-total')
  const modalList = document.getElementById('topping-list')
  const toppingsSection = document.getElementById('toppings-section')
  const qtySection = document.getElementById('qty-section')
  const modalQty = document.getElementById('modal-qty')
  const modalQtyDown = document.getElementById('modal-qty-down')
  const modalQtyUp = document.getElementById('modal-qty-up')
  const modalCancel = document.getElementById('modal-cancel')
  const modalConfirm = document.getElementById('modal-confirm')
  let toastTl = null
  let cartOpen = false

  function openCart() {
    cartOpen = true
    cartFloating.classList.remove('hidden')
    gsap.to(cartFloating, { y: 0, opacity: 1, duration: 0.3, ease: 'power3.out', overwrite: true })
  }

  function closeCart() {
    cartOpen = false
    gsap.to(cartFloating, {
      y: 16, opacity: 0, duration: 0.2, ease: 'power2.in', overwrite: true,
      onComplete: () => { cartFloating.classList.add('hidden') },
    })
  }

  function toggleCart() { cartOpen ? closeCart() : openCart() }

  openBtn.addEventListener('click', toggleCart)
  closeBtn.addEventListener('click', closeCart)

  function showToast(msg) {
    toastMsg.textContent = msg
    if (toastTl) toastTl.kill()
    toastTl = gsap.timeline()
    toastTl
      .set(toast, { clearProps: 'all' })
      .to(toast, { x: 0, opacity: 1, duration: 0.3, ease: 'power2.out' })
      .to(toast, { x: 0, opacity: 1, duration: 1.5 })
      .to(toast, { x: '100%', opacity: 0, duration: 0.3, ease: 'power2.in', onComplete: () => { toast.classList.add('hidden') } })
  }

  // --- Detail Modal ---
  let activeTrap = null

  function focusTrap(element) {
    const focusable = element.querySelectorAll(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    )
    const first = focusable[0]
    const last = focusable[focusable.length - 1]

    function handler(e) {
      if (e.key !== 'Tab') return
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault()
          last.focus()
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault()
          first.focus()
        }
      }
    }

    activeTrap = { element, handler, first, last }
    document.addEventListener('keydown', handler)
    if (first) first.focus()
  }

  function releaseTrap() {
    if (activeTrap) {
      document.removeEventListener('keydown', activeTrap.handler)
      activeTrap = null
    }
  }

  function openDetailModal(name, price, img, desc, hasExtras) {
    state.modalItem = { name, basePrice: price }
    state.modalToppings = []
    state.modalQty = 1
    state.modalHasExtras = hasExtras

    modalImg.src = img
    modalImg.alt = name
    modalName.textContent = name
    modalDesc.textContent = desc
    modalPrice.textContent = '$ ' + price.toFixed(2)

    if (hasExtras) {
      toppingsSection.classList.remove('hidden')
      qtySection.classList.add('hidden')
      renderModalToppings()
    } else {
      toppingsSection.classList.add('hidden')
      qtySection.classList.remove('hidden')
      modalQty.textContent = '1'
    }

    updateModalTotal()
    modal.classList.remove('hidden')
    gsap.from(modal.children[0], { scale: 0.95, opacity: 0, duration: 0.2, ease: 'power2.out' })
    focusTrap(modal)
  }

  function closeModal() {
    releaseTrap()
    modal.classList.add('hidden')
    state.modalItem = null
    state.modalToppings = []
    state.modalQty = 1
  }

  function renderModalToppings() {
    modalList.innerHTML = TOPPINGS.map((t, i) => `
      <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-gray-200 px-3 py-2.5 transition-all hover:border-red-300 hover:bg-red-50/50">
        <input type="checkbox" class="topping-cb hidden" data-index="${i}" />
        <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-md border-2 border-gray-300 text-xs font-bold text-transparent transition-all">&#10003;</span>
        <div class="flex-1">
          <span class="font-mono text-sm text-gray-800">${t.n}</span>
          <span class="ml-1.5 font-mono text-xs text-red-600 font-medium">+$${t.p.toFixed(2)}</span>
        </div>
      </label>
    `).join('')

    modalList.querySelectorAll('.topping-cb').forEach(cb => {
      cb.addEventListener('change', () => {
        const idx = parseInt(cb.dataset.index)
        const label = cb.closest('label')
        const check = label.querySelector('span:first-of-type')
        if (cb.checked) {
          state.modalToppings.push(idx)
          check.classList.add('bg-red-600', 'border-red-600', 'text-white')
          check.classList.remove('border-gray-300', 'text-transparent')
          label.classList.add('border-red-200', 'bg-red-50')
        } else {
          state.modalToppings = state.modalToppings.filter(i => i !== idx)
          check.classList.remove('bg-red-600', 'border-red-600', 'text-white')
          check.classList.add('border-gray-300', 'text-transparent')
          label.classList.remove('border-red-200', 'bg-red-50')
        }
        updateModalTotal()
      })
    })
  }

  function getModalToppingTotal() {
    return state.modalToppings.reduce((sum, i) => sum + TOPPINGS[i].p, 0)
  }

  function updateModalTotal() {
    if (state.modalHasExtras) {
      const extra = getModalToppingTotal()
      const total = state.modalItem.basePrice + extra
      modalTotal.textContent = '$ ' + total.toFixed(2)
    } else {
      const total = state.modalItem.basePrice * state.modalQty
      modalTotal.textContent = '$ ' + total.toFixed(2)
    }
  }

  function flyToCart(fromEl) {
    // ── SVG del volador ── editar aquí para cambiar el ícono ──
    const FLYER_SVG = `
      <svg viewBox="0 0 100 100" fill="#dc2626" stroke="#991b1b" stroke-width="2" stroke-linejoin="round">
        <path d="M50 8 L86 78 Q50 92 14 78 Z" stroke-width="1.5" />
        <path d="M14 78 Q50 92 86 78" stroke-width="3" stroke-linecap="round" />
        <path d="M50 8 Q52 16 48 20" stroke-width="1.5" stroke-linecap="round" />
        <circle cx="44" cy="52" r="4.5" stroke-width="1.5" />
        <circle cx="64" cy="60" r="4" stroke-width="1.5" />
        <circle cx="32" cy="66" r="3.5" stroke-width="1.5" />
        <circle cx="56" cy="44" r="3" stroke-width="1.5" />
        <circle cx="38" cy="44" r="2.5" stroke-width="1.5" />
        <circle cx="66" cy="70" r="3" stroke-width="1.5" />
      </svg>`
    // ────────────────────────────────────────────────────────

    if (!fromEl) return
    const from = fromEl.getBoundingClientRect()
    const to = openBtn.getBoundingClientRect()
    const size = 40

    const flyer = document.createElement('div')
    flyer.className = 'fixed z-[100] pointer-events-none flex items-center justify-center'
    flyer.style.left = (from.left + from.width / 2 - size / 2) + 'px'
    flyer.style.top = (from.top + from.height / 2 - size / 2) + 'px'
    flyer.style.width = size + 'px'
    flyer.style.height = size + 'px'
    flyer.innerHTML = FLYER_SVG.trim()
    flyer.querySelector('svg').classList.add('w-full', 'h-full', 'drop-shadow-xl')
    document.body.appendChild(flyer)

    const midX = (from.left + from.width / 2 + to.left + to.width / 2) / 2 - size / 2
    const midY = Math.max(from.top, to.top) + 100 - size / 2

    gsap.set(flyer, { scale: 1, opacity: 1 })
    gsap.to(flyer, {
      left: midX,
      top: midY,
      scale: 0.8,
      duration: 0.3,
      ease: 'power2.out',
      onComplete: () => {
        gsap.to(flyer, {
          left: to.left + to.width / 2 - size / 2,
          top: to.top + to.height / 2 - size / 2,
          scale: 0.3,
          opacity: 0.4,
          duration: 0.35,
          ease: 'power3.in',
          onComplete: () => {
            flyer.remove()
            openBtn.classList.remove('animate-ripple')
            void openBtn.offsetWidth
            openBtn.classList.add('animate-ripple')
            gsap.fromTo(openBtn, { scale: 0.92 }, { scale: 1, duration: 0.5, ease: 'power2.out', overwrite: true })
            setTimeout(() => openBtn.classList.remove('animate-ripple'), 700)
          }
        })
      }
    })
  }

  function addToCart(name, basePrice, price, qty, toppings, fromEl) {
    const existing = state.items.find(item =>
      item.name === name &&
      item.toppings.join('|') === (toppings || []).join('|')
    )
    if (existing) {
      existing.qty += qty
    } else {
      state.items.push({ name, basePrice, price, qty, toppings: toppings || [] })
    }
    if (fromEl) flyToCart(fromEl)
  }

  modalCancel.addEventListener('click', closeModal)

  modalQtyDown.addEventListener('click', () => {
    if (state.modalQty > 1) {
      state.modalQty--
      modalQty.textContent = state.modalQty
      updateModalTotal()
    }
  })

  modalQtyUp.addEventListener('click', () => {
    state.modalQty++
    modalQty.textContent = state.modalQty
    updateModalTotal()
  })

  modalConfirm.addEventListener('click', () => {
    if (!state.modalItem) return

    if (state.modalHasExtras) {
      const extra = getModalToppingTotal()
      const total = state.modalItem.basePrice + extra
      const selectedToppings = state.modalToppings.map(i => TOPPINGS[i].n)
      addToCart(state.modalItem.name, state.modalItem.basePrice, total, 1, selectedToppings, modalImg)
    } else {
      const qty = state.modalQty
      addToCart(state.modalItem.name, state.modalItem.basePrice, state.modalItem.basePrice, qty, [], modalImg)
    }

    const wasEmpty = state.items.length === 1 && state.items[0].qty === 1
    renderCart()
    closeModal()
    if (wasEmpty) openCart()
    showToast('Agregado: ' + state.modalItem.name)
  })

  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal()
  })

  // --- Direct add (+ button) ---
  document.querySelectorAll('.js-add-direct').forEach(el => {
    el.addEventListener('click', (e) => {
      e.stopPropagation()
      const btn = el.closest('.menu-item')
      const name = btn.dataset.name
      const price = parseFloat(btn.dataset.price)
      addToCart(name, price, price, 1, [], el)
      const wasEmpty = state.items.length === 1 && state.items[0].qty === 1
      renderCart()
      if (wasEmpty) openCart()
      showToast('Agregado: ' + name)
    })
  })

  // --- Currency ---
  function selectCurrency(curr) {
    state.currency = curr
    state.payment = null
    const slider = document.getElementById('curr-slider')
    slider.style.transform = curr === 'bs' ? 'translateX(100%)' : 'translateX(0)'
    document.querySelectorAll('#currency-switch span').forEach(el => {
      el.classList.toggle('text-red-600', el.dataset.curr === curr)
      el.classList.toggle('text-gray-600', el.dataset.curr !== curr)
    })
    renderPayMethods()
    renderCart()
  }

  document.querySelectorAll('#currency-switch span').forEach(el => {
    el.addEventListener('click', () => selectCurrency(el.dataset.curr))
  })
  selectCurrency(state.currency)

  // --- Payment methods ---
  function renderPayMethods() {
    const methods = PAY_METHODS[state.currency] || []
    payMethodsEl.innerHTML = methods.map(m => {
      const active = state.payment === m
      return `<button class="js-pay-opt flex-shrink-0 rounded-full border px-2 py-1 font-mono text-[11px] font-bold transition-all ${active ? 'bg-red-600 text-white border-red-600 shadow-sm' : 'text-gray-600 border-gray-200 hover:border-red-300 hover:text-red-600'}">${m}</button>`
    }).join('')
    payMethodsEl.querySelectorAll('.js-pay-opt').forEach(btn => {
      btn.addEventListener('click', () => {
        state.payment = btn.textContent.trim()
        renderPayMethods()
      })
    })
  }

  // --- Render cart ---
  function renderCart() {
    const count = state.items.reduce((s, i) => s + i.qty, 0)
    const hasItems = count > 0

    navCartCount.textContent = count
    navCartCount.classList.toggle('hidden', !hasItems)
    cartItemCount.textContent = hasItems ? count + ' item' + (count > 1 ? 's' : '') : '0 items'
    cartEmpty.classList.toggle('hidden', hasItems)
    cartList.classList.toggle('hidden', !hasItems)
    cartFooter.classList.toggle('hidden', !hasItems)

    if (!hasItems) return

    cartList.innerHTML = state.items.map((item, i) => {
      const lineTotal = convert(item.price * item.qty)
      const toppingsHtml = item.toppings && item.toppings.length
        ? item.toppings.map(t => `<span class="text-xs text-red-500/70">+ ${t}</span>`).join('')
        : ''
      return `
      <div class="cart-item rounded-lg border border-gray-100 bg-gray-50/50 px-3 py-2.5">
        <div class="flex items-center justify-between">
          <span class="font-mono text-sm font-bold text-gray-800 truncate">${item.name}</span>
          <button class="js-remove-item flex h-6 w-6 items-center justify-center rounded-full text-gray-600 hover:bg-gray-200 hover:text-red-600 transition-all flex-shrink-0 ml-1" data-index="${i}">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        ${toppingsHtml ? `<div class="mt-0.5 flex flex-col gap-0.5">${toppingsHtml}</div>` : ''}
        <div class="mt-1.5 flex items-center gap-2">
          <button class="js-qty-down flex h-6 w-6 items-center justify-center rounded-full border border-gray-300 text-xs text-gray-600 transition-all hover:border-red-300 hover:text-red-600" data-index="${i}" aria-label="Disminuir cantidad">-</button>
          <span class="font-mono text-sm text-gray-700 min-w-[1.2rem] text-center font-semibold">${item.qty}</span>
          <button class="js-qty-up flex h-6 w-6 items-center justify-center rounded-full border border-gray-300 text-xs text-gray-600 transition-all hover:border-red-300 hover:text-red-600" data-index="${i}" aria-label="Aumentar cantidad">+</button>
          <span class="ml-auto font-mono text-base text-red-600 font-bold">${formatPrice(lineTotal)}</span>
        </div>
      </div>`
    }).join('')

    const rawSubtotal = state.items.reduce((s, i) => s + i.price * i.qty, 0)
    const subtotal = convert(rawSubtotal)
    const tax = subtotal * 0.16
    const total = IVA_ON ? subtotal + tax : subtotal

    cartSubtotal.textContent = formatPrice(subtotal)
    cartTax.textContent = formatPrice(tax)
    cartTaxRow.classList.toggle('hidden', !IVA_ON)
    cartTotal.textContent = formatPrice(total)

    const orderLines = state.items.flatMap(i => {
      const lines = ['- ' + i.name + ' x' + i.qty]
      if (i.toppings && i.toppings.length) {
        i.toppings.forEach(t => lines.push('  + ' + t))
      }
      return lines
    })
    const msgParts = ['Hola! Quiero hacer un pedido:', '']
    msgParts.push(...orderLines)
    msgParts.push('')
    msgParts.push('Pago en: ' + (state.currency === 'usd' ? 'Divisas (USD)' : 'Bolívares (Bs)'))
    if (state.payment) msgParts.push('Método de pago: ' + state.payment)
    cartWaBtn.href = 'https://wa.me/584200000000?text=' + msgParts.join('%0A')

    document.querySelectorAll('.js-qty-down').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.index)
        if (state.items[idx].qty > 1) state.items[idx].qty--
        else state.items.splice(idx, 1)
        renderCart()
      })
    })
    document.querySelectorAll('.js-qty-up').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.index)
        state.items[idx].qty++
        renderCart()
      })
    })
    document.querySelectorAll('.js-remove-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.index)
        state.items.splice(idx, 1)
        renderCart()
      })
    })
  }

  // --- Lightbox ---
  const lightbox = document.getElementById('lightbox')
  const lightboxImg = document.getElementById('lightbox-img')
  const lightboxClose = document.getElementById('lightbox-close')

  document.querySelectorAll('.js-zoom').forEach(img => {
    img.addEventListener('click', (e) => {
      e.stopPropagation()
      const fullUrl = img.src.replace('w=600', 'w=1200')
      lightboxImg.src = fullUrl
      lightboxImg.alt = img.alt
      lightbox.classList.remove('hidden')
      gsap.from(lightboxImg, { scale: 0.9, opacity: 0, duration: 0.25, ease: 'power2.out' })
      focusTrap(lightbox)
    })
  })

  function closeLightbox() {
    releaseTrap()
    lightbox.classList.add('hidden')
    lightboxImg.src = ''
  }

  lightboxClose.addEventListener('click', closeLightbox)
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox() })
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox() })

  // --- Scroll to top ---
  const scrollTopBtn = document.getElementById('scroll-top')
  window.addEventListener('scroll', () => {
    const menuSection = document.getElementById('menu')
    if (!menuSection) return
    const rect = menuSection.getBoundingClientRect()
    scrollTopBtn.classList.toggle('show', rect.top < 0 && rect.bottom < window.innerHeight)
  })
  scrollTopBtn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' })
  })

  // --- Menu item click → open detail modal ---
  document.querySelectorAll('.menu-item').forEach(btn => {
    btn.addEventListener('click', () => {
      const hasExtras = btn.dataset.hasExtras === 'true'
      const name = btn.dataset.name
      const price = parseFloat(btn.dataset.price)
      const img = btn.dataset.img
      const desc = btn.dataset.desc
      openDetailModal(name, price, img, desc, hasExtras)
    })
  })

  fetchRate().finally(() => {
    applyRateToMenu()
    renderCart()
  })
  renderPayMethods()
</script>
