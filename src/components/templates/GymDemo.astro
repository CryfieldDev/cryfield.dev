<script>
  import { animate, stagger } from 'animejs'

  const BS_RATE = 50
  const DEFAULT_CURRENCY = 'usd'
  const PAY_METHODS = {
    usd: ['Zelle', 'Efectivo USD', 'USDT', 'PayPal'],
    bs: ['Pago movil', 'Transferencia'],
  }

  const state = {
    apiRate: null,
    currency: DEFAULT_CURRENCY,
    payment: null,
    billing: 'one-time',
  }

  // --- API ---
  async function fetchRate() {
    try {
      const res = await fetch('https://ve.dolarapi.com/v1/dolares/oficial')
      if (!res.ok) throw new Error('HTTP ' + res.status)
      const data = await res.json()
      if (data.promedio > 0) state.apiRate = data.promedio
      updatePrices()
    } catch (e) { console.warn('Failed to fetch rate, usando fallback') }
  }

  function getRate() {
    if (state.currency === 'usd') return 1
    return state.apiRate || (BS_RATE > 0 ? BS_RATE : 1)
  }

  function formatPrice(val) {
    if (state.currency === 'usd') return '$' + val.toFixed(2)
    return 'Bs.' + val.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
  }

  // --- Hero animations with anime.js ---
  animate('.hero-badge', { y: [20, 0], opacity: [0, 1], duration: 600, ease: 'outExpo', delay: 200 })
  animate('.hero-subtitle', { y: [30, 0], opacity: [0, 1], duration: 700, ease: 'outExpo', delay: 500 })
  animate('.hero-desc', { y: [20, 0], opacity: [0, 1], duration: 600, ease: 'outExpo', delay: 700 })
  animate('.hero-cta', { y: [20, 0], opacity: [0, 1], duration: 600, ease: 'outExpo', delay: 900 })
  animate('.hero-visual', { scale: [0.9, 1], opacity: [0, 1], duration: 1000, ease: 'outExpo', delay: 400 })

  // --- Scroll-triggered stat counters ---
  const statEls = document.querySelectorAll('.js-stat')
  let statsAnimated = false
  const statsObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !statsAnimated) {
        statsAnimated = true
        statEls.forEach(el => {
          const target = parseFloat(el.dataset.target)
          const suffix = el.dataset.suffix
          const isDecimal = target % 1 !== 0
          animate(el, {
            textContent: [0, target],
            duration: 2000,
            ease: 'outExpo',
            round: isDecimal ? 10 : 1,
            onUpdate: (anim) => {
              const val = isDecimal ? parseFloat(anim.textContent).toFixed(1) : Math.round(anim.textContent)
              el.textContent = val + (suffix || '')
            }
          })
        })
      }
    })
  }, { threshold: 0.5 })
  statEls.forEach(el => statsObserver.observe(el))

  // --- Toast ---
  const toast = document.getElementById('toast')
  const toastMsg = document.getElementById('toast-msg')

  function showToast(msg) {
    toastMsg.textContent = msg
    toast.classList.remove('hidden')
    toast.style.transform = 'translateX(100px)'
    toast.style.opacity = '0'
    animate(toast, { x: 0, opacity: 1, duration: 400, ease: 'outExpo' })
    setTimeout(() => {
      animate(toast, { x: 100, opacity: 0, duration: 300, ease: 'inExpo', onComplete: () => {
        toast.classList.add('hidden')
        toast.style.transform = ''
        toast.style.opacity = ''
      }})
    }, 2000)
  }

  // --- Scroll to top ---
  const scrollTopBtn = document.getElementById('scroll-top')
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) {
      scrollTopBtn.classList.remove('hidden')
      scrollTopBtn.classList.add('show')
    } else {
      scrollTopBtn.classList.add('hidden')
      scrollTopBtn.classList.remove('show')
    }
  })
  scrollTopBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))

  // --- Magnetic button effect ---
  document.querySelectorAll('.magnetic-btn').forEach(btn => {
    btn.addEventListener('mousemove', (e) => {
      const rect = btn.getBoundingClientRect()
      const x = e.clientX - rect.left - rect.width / 2
      const y = e.clientY - rect.top - rect.height / 2
      animate(btn, { x: x * 0.15, y: y * 0.15, duration: 300, ease: 'outQuad' })
    })
    btn.addEventListener('mouseleave', () => {
      animate(btn, { x: 0, y: 0, duration: 500, ease: 'outElastic(1, .5)' })
    })
  })

  // --- Scramble text on hover ---
  document.querySelectorAll('.scramble-text').forEach(el => {
    const original = el.dataset.text || el.textContent
    const chars = '!@#$%^&*()_+-=[]{}|;:,.<>?0123456789'
    let interval
    el.addEventListener('mouseenter', () => {
      let iteration = 0
      interval = setInterval(() => {
        el.textContent = original.split('').map((char, i) => {
          if (i < iteration) return original[i]
          return chars[Math.floor(Math.random() * chars.length)]
        }).join('')
        iteration += 1 / 2
        if (iteration >= original.length) clearInterval(interval)
      }, 30)
    })
    el.addEventListener('mouseleave', () => {
      clearInterval(interval)
      el.textContent = original
    })
  })

  // --- Detail Modal ---
  let activeTrap = null
  function focusTrap(element) {
    const focusable = element.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])')
    const first = focusable[0], last = focusable[focusable.length - 1]
    function handler(e) {
      if (e.key !== 'Tab') return
      if (e.shiftKey) { if (document.activeElement === first) { e.preventDefault(); last.focus() } }
      else { if (document.activeElement === last) { e.preventDefault(); first.focus() } }
    }
    activeTrap = { element, handler, first, last }
    document.addEventListener('keydown', handler)
    if (first) first.focus()
  }
  function releaseTrap() {
    if (activeTrap) { document.removeEventListener('keydown', activeTrap.handler); activeTrap = null }
  }

  const modal = document.getElementById('detail-modal')
  const modalImg = document.getElementById('modal-img')
  const modalName = document.getElementById('modal-name')
  const modalBadge = document.getElementById('modal-badge')
  const modalFeatures = document.getElementById('modal-features')
  const modalPrice = document.getElementById('modal-price')
  const modalCta = document.getElementById('modal-cta')
  const modalClose = document.getElementById('modal-close')

  function openDetailModal(card) {
    const name = card.dataset.name
    const img = card.dataset.img
    const features = JSON.parse(card.dataset.features)
    const badge = card.dataset.badge
    const priceOnetime = parseFloat(card.dataset.priceOnetime)
    const pricePermonth = parseFloat(card.dataset.pricePermonth)
    const price = state.billing === 'one-time' ? priceOnetime : pricePermonth

    modalImg.src = img
    modalImg.alt = name
    modalName.textContent = name
    modalBadge.textContent = badge || 'Plan ' + name
    modalBadge.classList.toggle('hidden', !badge)
    modalFeatures.innerHTML = features.map(f => `
      <li class="flex items-start gap-3 text-sm">
        <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
        <span class="text-orange-200/60">${f}</span>
      </li>
    `).join('')
    modalPrice.textContent = formatPrice(price * getRate())
    const periodLabel = state.billing === 'one-time' ? 'pago unico' : 'por mes'
    const msg = 'Hola! Quiero inscribirme en el plan ' + name + ' (' + periodLabel + ')'
    modalCta.href = 'https://wa.me/' + '584200000000' + '?text=' + encodeURIComponent(msg)
    modal.classList.remove('hidden')
    modal.classList.add('flex')
    animate(modal.querySelector('.modal-card'), { scale: [0.95, 1], opacity: [0, 1], duration: 300, ease: 'outExpo' })
    focusTrap(modal)
  }

  function closeModal() {
    releaseTrap()
    modal.classList.add('hidden')
    modal.classList.remove('flex')
  }

  modalClose.addEventListener('click', closeModal)
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal() })

  // --- Plan card click ---
  document.querySelectorAll('.js-plan-card').forEach(card => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.js-plan-card').forEach(c => {
        c.removeAttribute('data-selected')
        c.classList.remove('border-orange-600/40', 'shadow-2xl', 'shadow-orange-900/15')
        c.classList.add('border-orange-900/25')
      })
      card.setAttribute('data-selected', '')
      card.classList.remove('border-orange-900/25')
      card.classList.add('border-orange-600/40', 'shadow-2xl', 'shadow-orange-900/15')
    })
    card.addEventListener('dblclick', () => openDetailModal(card))
  })

  // --- Billing toggle ---
  document.querySelectorAll('.js-billing-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.js-billing-btn').forEach(b => {
        b.removeAttribute('data-on')
        b.classList.remove('bg-orange-500/15', 'text-orange-400')
        b.classList.add('text-orange-300/50')
      })
      btn.setAttribute('data-on', '')
      btn.classList.add('bg-orange-500/15', 'text-orange-400')
      btn.classList.remove('text-orange-300/50')
      state.billing = btn.dataset.period
      updatePrices()
    })
  })
  document.querySelector('.js-billing-btn[data-period="one-time"]')?.click()

  // --- Plan CTA ---
  document.getElementById('plan-cta').addEventListener('click', () => {
    const selected = document.querySelector('.js-plan-card[data-selected]') || document.querySelector('.js-plan-card')
    if (!selected) return
    const planId = selected.dataset.plan
    const planNames = { mensual: 'Mensual', trimestral: 'Trimestral', anual: 'Anual' }
    const priceKey = state.billing === 'one-time' ? 'price-onetime' : 'price-permonth'
    const price = parseFloat(selected.dataset[priceKey === 'price-onetime' ? 'priceOnetime' : 'pricePermonth'])
    const periodLabel = state.billing === 'one-time' ? 'pago unico' : 'por mes'
    const msg = 'Hola! Quiero inscribirme en el plan ' + planNames[planId] + ' (' + periodLabel + ') por ' + formatPrice(price * getRate()) + (state.payment ? ' - ' + state.payment : '')
    window.open('https://wa.me/584200000000?text=' + encodeURIComponent(msg), '_blank')
    showToast('Inscribiendote en plan ' + planNames[planId])
  })

  // --- Schedule day tabs ---
  document.querySelectorAll('.js-day-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.js-day-tab').forEach(t => t.removeAttribute('data-active'))
      tab.setAttribute('data-active', '')
      document.querySelectorAll('.js-day-schedule').forEach(el => el.classList.add('hidden'))
      const target = document.querySelector('.js-day-schedule[data-day="' + tab.dataset.day + '"]')
      if (target) {
        target.classList.remove('hidden')
        animate(target.querySelectorAll('.class-card'), {
          y: [15, 0],
          opacity: [0, 1],
          duration: 400,
          ease: 'outExpo',
          delay: stagger(50)
        })
      }
    })
  })

  // --- Schedule class WhatsApp ---
  document.querySelectorAll('.js-class-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const msg = 'Hola! Quiero apartar cupo para ' + btn.dataset.class + ' el ' + btn.dataset.day + ' a las ' + btn.dataset.time
      window.open('https://wa.me/584200000000?text=' + encodeURIComponent(msg), '_blank')
      showToast('Apartando cupo: ' + btn.dataset.class + ' ' + btn.dataset.time)
    })
  })

  // --- BMI Calculator ---
  function calcBmi() {
    const w = parseFloat(document.getElementById('bmi-weight').value)
    const h = parseFloat(document.getElementById('bmi-height').value) / 100
    if (!w || !h || h <= 0) return
    const bmi = w / (h * h)
    const result = document.getElementById('bmi-result')
    result.style.opacity = '1'
    animate(document.getElementById('bmi-value'), { textContent: [0, bmi], duration: 1000, ease: 'outExpo', round: 1 })
    let cat, desc, pct
    if (bmi < 18.5) { cat = 'Bajo peso'; desc = 'Te recomendamos el plan con nutricionista para llegar a tu peso ideal'; pct = 25 }
    else if (bmi < 25) { cat = 'Peso normal'; desc = 'Estas en un peso saludable. Mantenelo con nuestros planes de entrenamiento'; pct = 50 }
    else if (bmi < 30) { cat = 'Sobrepeso'; desc = 'Nuestro plan Trimestral con evaluacion fisica es ideal para vos'; pct = 75 }
    else { cat = 'Obesidad'; desc = 'Te recomendamos el plan Anual con seguimiento personalizado y nutricionista'; pct = 100 }
    document.getElementById('bmi-category').textContent = cat
    document.getElementById('bmi-desc').textContent = desc
    animate(document.getElementById('bmi-bar'), { width: [0, pct + '%'], duration: 800, ease: 'outExpo' })
  }

  document.getElementById('bmi-btn').addEventListener('click', calcBmi)
  document.getElementById('bmi-weight').addEventListener('input', calcBmi)
  document.getElementById('bmi-height').addEventListener('input', calcBmi)
  calcBmi()

  // --- Currency selector ---
  function selectCurrency(curr) {
    state.currency = curr
    state.payment = null
    const slider = document.getElementById('curr-slider')
    if (slider) slider.style.transform = curr === 'bs' ? 'translateX(100%)' : 'translateX(0)'
    document.querySelectorAll('#currency-switch span[data-curr]').forEach(el => {
      el.classList.toggle('text-orange-400', el.dataset.curr === curr)
      el.classList.toggle('text-orange-300/40', el.dataset.curr !== curr)
    })
    updatePrices()
    renderPayMethods()
  }

  document.querySelectorAll('#currency-switch span[data-curr]').forEach(el => {
    el.addEventListener('click', () => selectCurrency(el.dataset.curr))
  })
  selectCurrency(state.currency)

  // --- Payment methods ---
  function renderPayMethods() {
    const el = document.getElementById('pay-methods')
    const methods = PAY_METHODS[state.currency] || []
    el.innerHTML = methods.map(m => {
      const active = state.payment === m
      return `<button class="js-pay-opt flex-shrink-0 rounded-lg border px-3 py-1.5 font-mono text-[10px] font-bold transition-all duration-300 ${active ? 'bg-orange-500/15 text-orange-400 border-orange-500' : 'text-orange-300/40 border-orange-800/30 hover:border-orange-500/50 hover:text-orange-300/70'}">${m}</button>`
    }).join('')
    el.querySelectorAll('.js-pay-opt').forEach(btn => {
      btn.addEventListener('click', () => {
        state.payment = btn.textContent.trim()
        renderPayMethods()
      })
    })
  }

  function updatePrices() {
    const rate = getRate()
    document.querySelectorAll('.js-plan-card').forEach(card => {
      const priceKey = state.billing === 'one-time' ? 'priceOnetime' : 'pricePermonth'
      const usdPrice = parseFloat(card.dataset[priceKey])
      const priceEl = card.querySelector('.js-plan-price')
      const periodEl = card.querySelector('.js-plan-period')
      if (state.currency === 'usd') {
        priceEl.textContent = '$' + usdPrice.toFixed(2)
      } else {
        priceEl.textContent = 'Bs.' + (usdPrice * rate).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
      }
      periodEl.textContent = state.billing === 'one-time' ? 'Pago unico' : usdPrice + ' USD/mes'
    })
  }

  // --- Init ---
  fetchRate().finally(() => { updatePrices() })
  renderPayMethods()
</script>
