---
const r = {
  name: "Ruptura Fit",
  tagline: "El gimnasio donde el esfuerzo se convierte en resultado",
  desc: "Entrenamiento funcional, pesas, crossfit y clases grupales. Sin contratos, sin excusas.",
  wa: "584200000000",
  address: "Av. Principal de La Castellana, Centro Comercial Plaza, Nivel 2",
  schedule: "Lun-Sab: 6:00 - 22:00 | Dom: 8:00 - 14:00",
  ig: "@rupturafit",
  fb: "rupturafit",
  x: "@rupturafit",
}

const unsplash = (id, w=600) =>
  `https://images.unsplash.com/${id}?w=${w}&auto=format&fm=webp`

const plans = [
  {
    id: 'mensual',
    name: 'Mensual',
    monthly: 30,
    quarterly: null,
    annual: null,
    badge: null,
    perMonth: 30,
    img: unsplash("photo-1534438327276-14e5300c3a48"),
    features: [
      'Acceso completo al gimnasio',
      'Clases grupales ilimitadas',
      'Vestidores con duchas',
      'Sin permanencia',
    ],
  },
  {
    id: 'trimestral',
    name: 'Trimestral',
    monthly: null,
    quarterly: 75,
    annual: null,
    badge: 'Recomendado',
    perMonth: 25,
    img: unsplash("photo-1517836357463-d25dfeac3438"),
    features: [
      'Todo lo del plan Mensual',
      'Evaluacion fisica inicial',
      'Acceso 24h los 7 dias',
      'Ahorras $15 vs Mensual',
    ],
  },
  {
    id: 'anual',
    name: 'Anual',
    monthly: null,
    quarterly: null,
    annual: 120,
    badge: 'Mejor valor',
    perMonth: 10,
    img: unsplash("photo-1571019614242-c5c5dee9f50b"),
    features: [
      'Todo lo del plan Trimestral',
      'Sesion con nutricionista',
      'Seguimiento personalizado',
      'Ahorras $240 vs Mensual',
    ],
  },
]

const schedule = [
  { day: 'Lun', classes: [
    { time: '7:00', name: 'Crossfit' }, { time: '9:00', name: 'Yoga' },
    { time: '10:00', name: 'Spinning' }, { time: '17:00', name: 'Funcional' },
    { time: '18:30', name: 'Boxeo' }, { time: '20:00', name: 'Zumba' },
  ]},
  { day: 'Mar', classes: [
    { time: '7:00', name: 'Funcional' }, { time: '9:00', name: 'Pilates' },
    { time: '10:00', name: 'Crossfit' }, { time: '17:00', name: 'Boxeo' },
    { time: '18:30', name: 'Spinning' }, { time: '20:00', name: 'Yoga' },
  ]},
  { day: 'Mie', classes: [
    { time: '7:00', name: 'Spinning' }, { time: '9:00', name: 'Crossfit' },
    { time: '10:00', name: 'Funcional' }, { time: '17:00', name: 'Zumba' },
    { time: '18:30', name: 'Pilates' }, { time: '20:00', name: 'Boxeo' },
  ]},
  { day: 'Jue', classes: [
    { time: '7:00', name: 'Yoga' }, { time: '9:00', name: 'Funcional' },
    { time: '10:00', name: 'Boxeo' }, { time: '17:00', name: 'Crossfit' },
    { time: '18:30', name: 'Zumba' }, { time: '20:00', name: 'Spinning' },
  ]},
  { day: 'Vie', classes: [
    { time: '7:00', name: 'Crossfit' }, { time: '9:00', name: 'Spinning' },
    { time: '10:00', name: 'Yoga' }, { time: '17:00', name: 'Funcional' },
    { time: '18:30', name: 'Boxeo' }, { time: '20:00', name: 'Pilates' },
  ]},
  { day: 'Sab', classes: [
    { time: '8:00', name: 'Crossfit' }, { time: '9:30', name: 'Funcional' },
    { time: '11:00', name: 'Yoga' }, { time: '12:00', name: 'Zumba' },
  ]},
]
---

<section id="gym-content" class="min-h-screen bg-[#070605] text-[#fff7ed] font-sans overflow-x-hidden">
  <a href="/plantillas" class="fixed top-20 left-4 z-40 rounded-lg border border-orange-700/40 bg-[#070605]/80 px-3 py-2 font-mono text-xs text-orange-400/70 backdrop-blur-sm transition-all hover:text-orange-400 hover:border-orange-500/60">&lt;- Volver</a>

  <!-- Nav -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-orange-900/20 bg-[#070605]/90 backdrop-blur-lg">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="#" class="flex items-center gap-2 font-mono text-lg font-bold tracking-tight text-orange-500">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        RUPTURA
      </a>
      <div class="flex items-center gap-6">
        <a href="#planes" class="hidden text-sm text-orange-300/60 transition-colors hover:text-orange-400 sm:block">Planes</a>
        <a href="#clases" class="hidden text-sm text-orange-300/60 transition-colors hover:text-orange-400 sm:block">Clases</a>
        <a href="#imc" class="hidden text-sm text-orange-300/60 transition-colors hover:text-orange-400 sm:block">Tu IMC</a>
        <a href="#entrenadores" class="hidden text-sm text-orange-300/60 transition-colors hover:text-orange-400 sm:block">Staff</a>
        <a href={"https://wa.me/" + r.wa + "?text=Hola!%20Quiero%20entrenar%20en%20Ruptura%20Fit"} target="_blank" class="magnetic-btn rounded-lg border border-orange-600/30 bg-orange-500/10 px-4 py-2 text-xs font-bold text-orange-400 transition-all hover:bg-orange-500/20">QUIERO ENTRENAR</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative flex min-h-screen items-center overflow-hidden px-6 pt-24">
    <!-- Animated gradient orbs -->
    <div class="pointer-events-none absolute inset-0">
      <div class="hero-orb absolute top-1/4 left-1/4 h-[600px] w-[600px] rounded-full bg-gradient-to-br from-orange-600/20 via-red-600/10 to-transparent blur-[150px]"></div>
      <div class="hero-orb absolute bottom-1/4 right-1/4 h-[400px] w-[400px] rounded-full bg-gradient-to-tl from-red-600/15 via-orange-600/5 to-transparent blur-[120px]"></div>
    </div>

    <!-- Grid pattern -->
    <div class="pointer-events-none absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(234,88,12,0.4) 1px,transparent 1px),linear-gradient(90deg,rgba(234,88,12,0.4) 1px,transparent 1px);background-size:60px 60px"></div>

    <div class="hero-content relative z-10 mx-auto flex w-full max-w-6xl flex-col items-center gap-16 lg:flex-row">
      <div class="flex-1 text-center lg:text-left">
        <div class="hero-badge mb-6 inline-flex items-center gap-2 rounded-full border border-orange-700/30 bg-orange-900/20 px-4 py-1.5 font-mono text-[11px] text-orange-500 uppercase tracking-[0.2em] backdrop-blur-sm">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-orange-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-orange-500"></span>
          </span>
          Abierto ahora
        </div>
        <h1 class="hero-title mb-6 text-6xl font-black leading-[0.85] tracking-tight sm:text-7xl md:text-8xl lg:text-9xl">
          <span class="block overflow-hidden"><span class="hero-line block bg-gradient-to-r from-orange-400 via-orange-500 to-red-500 bg-clip-text text-transparent">ROMPE</span></span>
          <span class="block overflow-hidden"><span class="hero-line block text-orange-100">TUS</span></span>
          <span class="block overflow-hidden"><span class="hero-line block text-orange-100">LIMITES</span></span>
        </h1>
        <p class="hero-subtitle mb-4 max-w-xl text-lg text-orange-300/60 sm:text-xl">{r.tagline}</p>
        <p class="hero-desc mb-10 max-w-md text-sm text-orange-300/40">{r.desc}</p>
        <div class="hero-cta flex flex-col items-center gap-4 sm:flex-row lg:justify-start">
          <a href="#planes" class="magnetic-btn group inline-flex items-center gap-3 rounded-xl bg-gradient-to-r from-orange-600 to-red-600 px-10 py-4 font-mono text-sm font-bold text-white shadow-lg shadow-orange-900/30 transition-all duration-300 hover:shadow-xl hover:shadow-orange-800/40 hover:-translate-y-0.5">
            <span>VER PLANES</span>
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href={"https://wa.me/" + r.wa + "?text=Quiero%20mi%20clase%20de%20prueba%20gratis"} target="_blank" class="text-sm text-orange-300/60 underline underline-offset-8 decoration-orange-800/30 transition-colors hover:text-orange-300 hover:decoration-orange-500/50">Clase de prueba gratis</a>
        </div>
      </div>
      <div class="hero-visual flex-1 flex justify-center lg:justify-end">
        <!-- Animated SVG Dumbbell -->
        <div class="relative h-80 w-80 sm:h-96 sm:w-96">
          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-orange-600/10 to-red-600/5 blur-3xl"></div>
          <svg class="hero-svg relative h-full w-full" viewBox="0 0 400 400" fill="none">
            <!-- Outer ring -->
            <circle cx="200" cy="200" r="180" stroke="url(#grad1)" stroke-width="0.5" opacity="0.3" class="hero-ring" />
            <circle cx="200" cy="200" r="150" stroke="url(#grad1)" stroke-width="0.5" opacity="0.2" class="hero-ring" />
            <!-- Dumbbell shape -->
            <g class="hero-dumbbell" transform="translate(200,200)">
              <rect x="-100" y="-12" width="60" height="24" rx="4" fill="url(#grad1)" opacity="0.8" />
              <rect x="40" y="-12" width="60" height="24" rx="4" fill="url(#grad1)" opacity="0.8" />
              <rect x="-40" y="-6" width="80" height="12" rx="6" fill="url(#grad1)" opacity="0.6" />
              <rect x="-120" y="-20" width="20" height="40" rx="6" fill="url(#grad2)" opacity="0.9" />
              <rect x="100" y="-20" width="20" height="40" rx="6" fill="url(#grad2)" opacity="0.9" />
            </g>
            <!-- Orbiting dots -->
            <circle class="orbit-dot" cx="200" cy="20" r="4" fill="#ea580c" opacity="0.6" />
            <circle class="orbit-dot" cx="380" cy="200" r="3" fill="#ef4444" opacity="0.5" />
            <circle class="orbit-dot" cx="200" cy="380" r="4" fill="#f97316" opacity="0.6" />
            <circle class="orbit-dot" cx="20" cy="200" r="3" fill="#dc2626" opacity="0.5" />
            <defs>
              <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#f97316" />
                <stop offset="100%" stop-color="#ef4444" />
              </linearGradient>
              <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#ea580c" />
                <stop offset="100%" stop-color="#dc2626" />
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
      <span class="font-mono text-[10px] text-orange-400/60 uppercase tracking-widest">Scroll</span>
      <div class="h-8 w-5 rounded-full border border-orange-500/30 p-1">
        <div class="scroll-dot h-1.5 w-1.5 rounded-full bg-orange-500/60"></div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-t border-orange-900/15 px-6 py-20">
    <div class="mx-auto max-w-5xl">
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
        {[
          { value: 500, suffix: '+', label: 'Alumnos activos' },
          { value: 10, suffix: '+', label: 'Años de experiencia' },
          { value: 15, suffix: '', label: 'Instructores certificados' },
          { value: 4.9, suffix: '/5', label: 'Rating promedio' },
        ].map((stat, i) => (
          <div class="stat-card group relative overflow-hidden rounded-2xl border border-orange-900/20 bg-gradient-to-b from-[#181512]/60 to-[#0f0d0a]/60 p-6 text-center transition-all duration-500 hover:border-orange-600/30 hover:shadow-lg hover:shadow-orange-900/10">
            <div class="absolute inset-0 bg-gradient-to-b from-orange-500/5 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
            <div class="js-stat font-mono text-3xl font-black text-orange-100 sm:text-4xl relative" data-target={stat.value} data-suffix={stat.suffix}>0{stat.suffix}</div>
            <div class="mt-2 text-xs text-orange-400/60 relative">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Animated Divider -->
  <div class="relative h-px w-full overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-orange-500/50 to-transparent"></div>
    <div class="divider-glow absolute inset-0 bg-gradient-to-r from-transparent via-orange-400 to-transparent opacity-0 blur-sm"></div>
  </div>

  <!-- Planes -->
  <section id="planes" class="px-6 py-32">
    <div class="mx-auto max-w-6xl">
      <div class="mb-4 text-center font-mono text-[11px] text-orange-500/70 uppercase tracking-[0.2em]">// membresia</div>
      <h2 class="mb-4 text-center text-5xl font-black tracking-tight sm:text-6xl"><span class="scramble-text" data-text="ELEGI TU">ELEGI TU</span> <span class="bg-gradient-to-r from-orange-400 to-red-500 bg-clip-text text-transparent">PLAN</span></h2>
      <p class="mb-6 text-center text-sm text-orange-300/70">Sin contratos, pago unico, acceso inmediato</p>

      <!-- Billing toggle -->
      <div class="mb-14 flex justify-center">
        <div id="billing-toggle" class="inline-flex rounded-xl border border-orange-800/30 bg-[#181512]/80 p-1 backdrop-blur-sm">
          <button class="js-billing-btn rounded-lg px-6 py-2.5 font-mono text-xs font-bold text-orange-300/50 transition-all duration-300" data-period="one-time" data-on="true" aria-label="Pago único">Pago unico</button>
          <button class="js-billing-btn rounded-lg px-6 py-2.5 font-mono text-xs font-bold text-orange-300/50 transition-all duration-300" data-period="per-month" aria-label="Por mes">Por mes</button>
        </div>
      </div>

      <div class="mb-12 grid gap-6 md:grid-cols-3">
        {plans.map((plan) => (
          <button
            class="plan-card js-plan-card group relative overflow-hidden rounded-2xl border border-orange-900/25 bg-gradient-to-b from-[#181512]/80 to-[#0f0d0a]/80 p-0 text-left transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-orange-900/20"
            data-plan={plan.id}
            data-price-onetime={(plan.monthly || plan.quarterly || plan.annual).toFixed(2)}
            data-price-permonth={plan.perMonth}
            data-img={plan.img}
            data-name={plan.name}
            data-features={JSON.stringify(plan.features)}
            data-badge={plan.badge || ''}
          >
            {plan.badge && (
              <div class="absolute -top-0.5 left-0 right-0 z-10 h-1 bg-gradient-to-r from-orange-500 to-red-500"></div>
            )}
            <!-- Image -->
            <div class="relative h-48 overflow-hidden">
              <img src={plan.img} alt={plan.name} loading="lazy" width="400" height="192" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" onerror="this.style.display='none'" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0f0d0a] via-[#0f0d0a]/60 to-transparent"></div>
              {plan.badge && (
                <div class="absolute top-4 right-4 rounded-full bg-gradient-to-r from-orange-600 to-red-600 px-3 py-1 font-mono text-[10px] font-bold text-white uppercase tracking-wider shadow-lg">{plan.badge}</div>
              )}
            </div>
            <!-- Content -->
            <div class="p-7">
              <div class="mb-1 font-mono text-xs font-bold text-orange-500/80 uppercase tracking-widest">{plan.name}</div>
              <div class="mb-1 flex items-baseline gap-1">
                <span class="js-plan-price font-mono text-5xl font-black text-orange-100">${(plan.monthly || plan.quarterly || plan.annual).toFixed(2)}</span>
              </div>
              <div class="mb-6 font-mono text-[11px] text-orange-400/50 js-plan-period">Pago unico</div>
              <ul class="mb-6 space-y-3">
                {plan.features.map((f) => (
                  <li class="flex items-start gap-3 text-sm">
                    <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                    <span class="text-orange-200/60">{f}</span>
                  </li>
                ))}
              </ul>
              <div class="w-full rounded-xl border border-orange-700/30 py-3 text-center font-mono text-xs font-bold text-orange-400 transition-all duration-300 group-hover:border-orange-500/50 group-hover:bg-orange-500/10 group-hover:text-orange-300">
                VER DETALLES
              </div>
            </div>
            <!-- Gradient border effect on hover -->
            <div class="pointer-events-none absolute inset-0 rounded-2xl border border-transparent transition-all duration-500 group-hover:border-orange-500/20"></div>
          </button>
        ))}
      </div>

      <!-- Purchase row -->
      <div class="mx-auto max-w-2xl overflow-hidden rounded-2xl border border-orange-900/20 bg-gradient-to-b from-[#181512]/60 to-[#0f0d0a]/60">
        <div class="h-px bg-gradient-to-r from-transparent via-orange-500/30 to-transparent"></div>
        <div class="flex flex-wrap items-center justify-center gap-4 p-6">
          <div id="currency-switch" class="relative flex cursor-pointer rounded-lg border border-orange-800/30 bg-[#181512]/60 p-0.5 select-none overflow-hidden">
            <div id="curr-slider" class="absolute top-0.5 bottom-0.5 w-1/2 rounded-md bg-orange-500/15 shadow-sm transition-transform duration-200 ease-out"></div>
            <span class="relative z-10 flex-1 px-4 py-2 text-center font-mono text-xs font-bold" data-curr="usd">$ USD</span>
            <span class="relative z-10 flex-1 px-4 py-2 text-center font-mono text-xs font-bold" data-curr="bs">Bs.</span>
          </div>
          <div id="pay-methods" class="flex flex-nowrap gap-1 overflow-x-auto"></div>
          <button id="plan-cta" class="magnetic-btn rounded-xl bg-gradient-to-r from-orange-600 to-red-600 px-8 py-3 font-mono text-sm font-bold text-white shadow-lg shadow-orange-900/30 transition-all duration-300 hover:shadow-xl hover:shadow-orange-800/40 hover:-translate-y-0.5" aria-label="Inscribirme ahora al plan seleccionado">
            INSCRIBIRME AHORA
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Detail Modal -->
  <div id="detail-modal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/70 backdrop-blur-md" role="dialog" aria-modal="true" aria-label="Detalle del plan">
    <div class="modal-card mx-4 w-full max-w-lg overflow-hidden rounded-3xl border border-orange-900/30 bg-[#0f0d0a] shadow-2xl shadow-black/60">
      <div class="relative h-56 sm:h-64">
        <img id="modal-img" src="" alt="" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0f0d0a] via-[#0f0d0a]/40 to-transparent"></div>
        <button id="modal-close" class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur-sm transition-all duration-300 hover:bg-black/60 hover:scale-110">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="px-7 py-6">
        <div class="mb-1 font-mono text-xs font-bold text-orange-500 uppercase tracking-widest" id="modal-badge"></div>
        <h3 id="modal-name" class="font-mono text-2xl font-black text-orange-100"></h3>
        <ul id="modal-features" class="mt-5 space-y-3"></ul>
        <div class="mt-6 flex items-center justify-between border-t border-orange-900/20 pt-5">
          <div>
            <span class="font-mono text-xs text-orange-400/50">Desde</span>
            <p id="modal-price" class="font-mono text-3xl font-black text-orange-100"></p>
          </div>
          <a id="modal-cta" href="#" target="_blank" class="magnetic-btn rounded-xl bg-gradient-to-r from-orange-600 to-red-600 px-6 py-3 font-mono text-sm font-bold text-white transition-all duration-300 hover:shadow-lg hover:shadow-orange-800/30">
            INSCRIBIRME
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Clases -->
  <section id="clases" class="border-t border-orange-900/15 px-6 py-32">
    <div class="mx-auto max-w-5xl">
      <div class="mb-4 text-center font-mono text-[11px] text-orange-500/70 uppercase tracking-[0.2em]">// horarios</div>
      <h2 class="mb-4 text-center text-5xl font-black tracking-tight sm:text-6xl">CLASES <span class="bg-gradient-to-r from-orange-400 to-red-500 bg-clip-text text-transparent">WEEKLY</span></h2>
      <p class="mb-12 text-center text-sm text-orange-300/50">Toca una clase para apartar tu cupo por WhatsApp</p>

      <!-- Day tabs -->
      <div class="mb-8 flex flex-wrap justify-center gap-2">
        {schedule.map((d, idx) => (
          <button class="js-day-tab rounded-xl border border-orange-800/30 px-5 py-2.5 font-mono text-xs font-bold text-orange-300/50 transition-all duration-300 hover:border-orange-600/40 hover:text-orange-400 data-active:bg-orange-500/15 data-active:border-orange-500/50 data-active:text-orange-400 data-active:shadow-lg data-active:shadow-orange-900/10" data-day={d.day} data-active={idx === 0 ? '' : undefined} aria-label={"Día " + d.day}>
            {d.day}
          </button>
        ))}
      </div>

      <!-- Schedule -->
      {schedule.map((d, idx) => (
        <div class={`js-day-schedule ${idx === 0 ? '' : 'hidden'}`} data-day={d.day}>
          <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3">
            {d.classes.map((cls) => (
              <button
                class="class-card js-class-btn group flex items-center justify-between rounded-2xl border border-orange-900/25 bg-gradient-to-b from-[#181512]/60 to-[#0f0d0a]/60 px-6 py-5 text-left transition-all duration-300 hover:-translate-y-1 hover:border-orange-600/40 hover:bg-orange-900/10 hover:shadow-lg hover:shadow-orange-900/10"
                data-day={d.day}
                data-time={cls.time}
                data-class={cls.name}
                aria-label={"Apartar cupo para " + cls.name + " el " + d.day + " a las " + cls.time}
              >
                <div>
