---
import '../../../styles/global.css'

const r = {
  name: "Ruptura Fit",
  tagline: "Donde el esfuerzo se convierte en resultado",
  desc: "Entrenamiento funcional, pesas, crossfit y clases grupales. Sin contratos, sin excusas.",
  wa: "584200000000",
  address: "Av. Principal de La Castellana, Centro Comercial Plaza, Nivel 2",
  schedule: "Lun-Sab: 6:00 - 22:00 | Dom: 8:00 - 14:00",
  ig: "@rupturafit",
  fb: "rupturafit",
}

const unsplash = (id, w=800) =>
  `https://images.unsplash.com/${id}?w=${w}&auto=format&fm=webp&q=80`

const plans = [
  {
    id: 'mensual',
    name: 'Mensual',
    price: 30,
    perMonth: 30,
    badge: null,
    img: unsplash("photo-1534438327276-14e5300c3a48"),
    features: ['Acceso completo', 'Clases ilimitadas', 'Vestidores + duchas', 'Sin permanencia'],
  },
  {
    id: 'trimestral',
    name: 'Trimestral',
    price: 75,
    perMonth: 25,
    badge: 'Popular',
    img: unsplash("photo-1517836357463-d25dfeac3438"),
    features: ['Todo lo del Mensual', 'Evaluacion fisica', 'Acceso 24/7', 'Ahorras $15'],
  },
  {
    id: 'anual',
    name: 'Anual',
    price: 120,
    perMonth: 10,
    badge: 'Mejor precio',
    img: unsplash("photo-1571019614242-c5c5dee9f50b"),
    features: ['Todo lo del Trimestral', 'Nutricionista', 'Seguimiento', 'Ahorras $240'],
  },
]

const schedule = [
  { day: 'Lun', items: [{ t: '7:00', n: 'Crossfit' }, { t: '9:00', n: 'Yoga' }, { t: '10:00', n: 'Spinning' }, { t: '17:00', n: 'Funcional' }, { t: '18:30', n: 'Boxeo' }, { t: '20:00', n: 'Zumba' }] },
  { day: 'Mar', items: [{ t: '7:00', n: 'Funcional' }, { t: '9:00', n: 'Pilates' }, { t: '10:00', n: 'Crossfit' }, { t: '17:00', n: 'Boxeo' }, { t: '18:30', n: 'Spinning' }, { t: '20:00', n: 'Yoga' }] },
  { day: 'Mie', items: [{ t: '7:00', n: 'Spinning' }, { t: '9:00', n: 'Crossfit' }, { t: '10:00', n: 'Funcional' }, { t: '17:00', n: 'Zumba' }, { t: '18:30', n: 'Pilates' }, { t: '20:00', n: 'Boxeo' }] },
  { day: 'Jue', items: [{ t: '7:00', n: 'Yoga' }, { t: '9:00', n: 'Funcional' }, { t: '10:00', n: 'Boxeo' }, { t: '17:00', n: 'Crossfit' }, { t: '18:30', n: 'Zumba' }, { t: '20:00', n: 'Spinning' }] },
  { day: 'Vie', items: [{ t: '7:00', n: 'Crossfit' }, { t: '9:00', n: 'Spinning' }, { t: '10:00', n: 'Yoga' }, { t: '17:00', n: 'Funcional' }, { t: '18:30', n: 'Boxeo' }, { t: '20:00', n: 'Pilates' }] },
  { day: 'Sab', items: [{ t: '8:00', n: 'Crossfit' }, { t: '9:30', n: 'Funcional' }, { t: '11:00', n: 'Yoga' }, { t: '12:00', n: 'Zumba' }] },
]

const trainers = [
  { name: 'Luis M.', role: 'Crossfit', exp: '8 años', emoji: '🏋️', speciality: 'HIIT & Calistenia' },
  { name: 'Ana P.', role: 'Yoga', exp: '6 años', emoji: '🧘', speciality: 'Vinyasa & Restaurativo' },
  { name: 'Carlos G.', role: 'Boxeo', exp: '10 años', emoji: '🥊', speciality: 'Combate & Técnica' },
  { name: 'Valentina R.', role: 'Spinning', exp: '5 años', emoji: '🚴', speciality: 'Ritmo & Endurance' },
]

const reviews = [
  { name: 'Sofia M.', text: 'En 3 meses logré lo que no pude en años. Los instructores son de otro nivel.', rating: 5, plan: 'Trimestral' },
  { name: 'Luis R.', text: 'El mejor gym de Caracas. Equipos nuevos, ambiente que te motiva a volver todos los dias.', rating: 5, plan: 'Anual' },
  { name: 'Camila P.', text: 'Baje 12 kilos en 4 meses. Las clases de crossfit cambiaron mi vida por completo.', rating: 5, plan: 'Mensual' },
]
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ruptura Fit — Gym Demo | Cryfield.dev</title>
  <meta name="description" content="Planes de membresía, parrilla de clases semanales y calculadora de IMC. Demo de plantilla para gimnasios por Cryfield.dev." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-[#09090b] text-[#fafafa] antialiased overflow-x-hidden">

  <!-- Back -->
  <a href="/plantillas" class="fixed top-6 left-6 z-50 flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 font-mono text-xs text-white/50 backdrop-blur-xl transition-all duration-300 hover:border-white/20 hover:text-white/80 hover:bg-white/10">
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
    Volver
  </a>

  <!-- Nav -->
  <nav class="fixed top-0 inset-x-0 z-40 border-b border-white/5 bg-[#09090b]/80 backdrop-blur-2xl">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
      <div class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-amber-500 to-orange-600">
          <svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
        </div>
        <span class="font-mono text-sm font-bold tracking-tight text-white">RUPTURA</span>
      </div>
      <div class="flex items-center gap-8">
        <a href="#plans" class="hidden text-sm text-white/40 transition-colors hover:text-white sm:block">Planes</a>
        <a href="#classes" class="hidden text-sm text-white/40 transition-colors hover:text-white sm:block">Clases</a>
        <a href="#bmi" class="hidden text-sm text-white/40 transition-colors hover:text-white sm:block">IMC</a>
        <a href="#team" class="hidden text-sm text-white/40 transition-colors hover:text-white sm:block">Staff</a>
        <a href={`https://wa.me/${r.wa}?text=Hola!%20Quiero%20entrenar`} target="_blank" class="magnetic rounded-full bg-white px-5 py-2 font-mono text-xs font-bold text-black transition-all duration-300 hover:bg-white/90">
          QUIERO ENTRENAR
        </a>
      </div>
    </div>
  </nav>

  <!-- ═══════ HERO ═══════ -->
  <section class="relative min-h-screen flex items-center justify-center px-6 pt-20 overflow-hidden">
    <!-- Background image -->
    <div class="absolute inset-0">
      <img src={unsplash("photo-1534438327276-14e5300c3a48", 1920)} alt="" class="h-full w-full object-cover opacity-20" loading="eager" width="1920" height="1080" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#09090b] via-[#09090b]/60 to-[#09090b]"></div>
    </div>

    <!-- Noise texture overlay -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');background-size:128px 128px"></div>

    <div class="relative z-10 mx-auto max-w-5xl text-center">
      <!-- Badge -->
      <div class="hero-el mb-8 inline-flex items-center gap-2 rounded-full border border-amber-500/20 bg-amber-500/10 px-4 py-1.5 backdrop-blur-sm">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-amber-500"></span>
        </span>
        <span class="font-mono text-[11px] text-amber-400 uppercase tracking-widest">Abierto ahora</span>
      </div>

      <!-- Title -->
      <h1 class="mb-6 text-[clamp(3rem,10vw,8rem)] font-black leading-[0.85] tracking-tighter">
        <span class="hero-el block text-white">ROMPE</span>
        <span class="hero-el block bg-gradient-to-r from-amber-400 via-orange-500 to-red-500 bg-clip-text text-transparent">TUS LIMITES</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-el mx-auto mb-4 max-w-lg text-lg text-white/50">{r.tagline}</p>
      <p class="hero-el mx-auto mb-12 max-w-md text-sm text-white/30">{r.desc}</p>

      <!-- CTA -->
      <div class="hero-el flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="#plans" class="magnetic group flex items-center gap-3 rounded-full bg-white px-8 py-4 font-mono text-sm font-bold text-black transition-all duration-300 hover:bg-white/90 hover:shadow-2xl hover:shadow-white/10">
          EMPEZAR AHORA
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href={`https://wa.me/${r.wa}?text=Quiero%20clase%20de%20prueba`} target="_blank" class="text-sm text-white/40 underline underline-offset-4 decoration-white/20 transition-colors hover:text-white/70 hover:decoration-white/40">
          Clase de prueba gratis
        </a>
      </div>

      <!-- Stats row -->
      <div class="hero-el mt-20 grid grid-cols-3 gap-8 border-t border-white/10 pt-10">
        <div>
          <div class="hero-stat font-mono text-4xl font-black text-white sm:text-5xl" data-target="500" data-suffix="+">0</div>
          <div class="mt-1 text-xs text-white/30">Alumnos activos</div>
        </div>
        <div>
          <div class="hero-stat font-mono text-4xl font-black text-white sm:text-5xl" data-target="10" data-suffix="+">0</div>
          <div class="mt-1 text-xs text-white/30">Años</div>
        </div>
        <div>
          <div class="hero-stat font-mono text-4xl font-black text-white sm:text-5xl" data-target="4.9" data-suffix="/5" data-decimal="true">0</div>
          <div class="mt-1 text-xs text-white/30">Rating</div>
        </div>
      </div>
    </div>

    <!-- Scroll -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
      <div class="h-10 w-6 rounded-full border border-white/20 p-1">
        <div class="scroll-indicator mx-auto h-2 w-2 rounded-full bg-white/40"></div>
      </div>
    </div>
  </section>

  <!-- ═══════ PLANS ═══════ -->
  <section id="plans" class="relative px-6 py-32">
    <div class="mx-auto max-w-6xl">
      <div class="mb-16 text-center">
        <p class="mb-3 font-mono text-[11px] text-amber-500 uppercase tracking-[0.2em]">// membresia</p>
        <h2 class="text-5xl font-black tracking-tight sm:text-6xl">ELEGÍ TU <span class="bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent">PLAN</span></h2>
        <p class="mt-4 text-sm text-white/40">Pago unico. Sin contratos. Acceso inmediato.</p>
      </div>

      <!-- Billing toggle -->
      <div class="mb-14 flex justify-center">
        <div class="inline-flex rounded-full border border-white/10 bg-white/5 p-1 backdrop-blur-sm">
          <button class="billing-btn rounded-full px-6 py-2.5 font-mono text-xs font-bold transition-all duration-300 bg-white text-black" data-period="one-time">Pago unico</button>
          <button class="billing-btn rounded-full px-6 py-2.5 font-mono text-xs font-bold transition-all duration-300 text-white/50 hover:text-white/80" data-period="per-month">Por mes</button>
        </div>
      </div>

      <!-- Cards -->
      <div class="grid gap-6 md:grid-cols-3">
        {plans.map((plan, i) => (
          <div
            class={`plan-card group relative overflow-hidden rounded-3xl border transition-all duration-500 ${plan.badge ? 'border-amber-500/30 bg-gradient-to-b from-amber-500/10 to-white/[0.02]' : 'border-white/10 bg-white/[0.02]'} hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/5`}
            data-plan={plan.id}
            data-price={plan.price}
            data-permonth={plan.perMonth}
          >
            {plan.badge && <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-amber-500 to-transparent"></div>}
            <!-- Image -->
            <div class="relative h-48 overflow-hidden">
              <img src={plan.img} alt={plan.name} loading="lazy" width="400" height="192" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#09090b] via-[#09090b]/50 to-transparent"></div>
              {plan.badge && (
                <div class="absolute top-4 right-4 rounded-full bg-amber-500 px-3 py-1 font-mono text-[10px] font-bold text-black uppercase tracking-wider">{plan.badge}</div>
              )}
            </div>
            <!-- Content -->
            <div class="p-7">
              <div class="font-mono text-xs text-white/40 uppercase tracking-widest">{plan.name}</div>
              <div class="mt-2 flex items-baseline gap-1">
                <span class="plan-price font-mono text-5xl font-black text-white">${plan.price.toFixed(2)}</span>
                <span class="text-sm text-white/30">USD</span>
              </div>
              <div class="plan-period mt-1 font-mono text-[11px] text-white/30">pago unico</div>
              <ul class="mt-6 mb-8 space-y-3">
                {plan.features.map(f => (
                  <li class="flex items-center gap-3 text-sm text-white/60">
                    <svg class="h-4 w-4 flex-shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                    {f}
                  </li>
                ))}
              </ul>
              <button class="plan-select-btn w-full rounded-xl border border-white/10 py-3.5 font-mono text-xs font-bold text-white/60 transition-all duration-300 group-hover:border-white/30 group-hover:bg-white/5 group-hover:text-white">
                SELECCIONAR
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- Currency + CTA -->
      <div class="mt-12 mx-auto max-w-2xl rounded-2xl border border-white/10 bg-white/[0.02] p-6 backdrop-blur-sm">
        <div class="flex flex-wrap items-center justify-center gap-4">
          <div class="flex gap-1">
            <label class="curr-opt cursor-pointer rounded-lg border border-white/10 px-4 py-2 font-mono text-xs text-white/50 transition-all duration-300 has-[:checked]:border-amber-500/50 has-[:checked]:bg-amber-500/10 has-[:checked]:text-amber-400">
              <input type="radio" name="currency" value="usd" class="hidden" checked> USD
            </label>
            <label class="curr-opt cursor-pointer rounded-lg border border-white/10 px-4 py-2 font-mono text-xs text-white/50 transition-all duration-300 has-[:checked]:border-amber-500/50 has-[:checked]:bg-amber-500/10 has-[:checked]:text-amber-400">
              <input type="radio" name="currency" value="bs" class="hidden"> Bs
            </label>
          </div>
          <div id="pay-methods" class="flex gap-1"></div>
          <button id="plan-cta" class="magnetic rounded-xl bg-white px-8 py-3 font-mono text-sm font-bold text-black transition-all duration-300 hover:bg-white/90">
            INSCRIBIRME
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ DETAIL MODAL ═══════ -->
  <div id="modal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/80 backdrop-blur-xl" role="dialog" aria-modal="true">
    <div class="modal-card mx-4 w-full max-w-md overflow-hidden rounded-3xl border border-white/10 bg-[#18181b] shadow-2xl">
      <div class="relative h-52">
        <img id="modal-img" src="" alt="" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#18181b] to-transparent"></div>
        <button id="modal-close" class="absolute top-4 right-4 flex h-9 w-9 items-center justify-center rounded-full bg-black/50 text-white backdrop-blur-sm transition-all hover:bg-black/70">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="p-6">
        <div id="modal-badge" class="mb-1 font-mono text-[10px] text-amber-500 uppercase tracking-widest"></div>
        <h3 id="modal-name" class="font-mono text-xl font-bold text-white"></h3>
        <ul id="modal-features" class="mt-4 space-y-2"></ul>
        <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-5">
          <div>
            <span class="text-xs text-white/40">Desde</span>
            <p id="modal-price" class="font-mono text-2xl font-bold text-white"></p>
          </div>
          <a id="modal-cta" href="#" target="_blank" class="rounded-xl bg-white px-6 py-3 font-mono text-xs font-bold text-black transition-all hover:bg-white/90">INSCRIBIRME</a>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════ SCHEDULE ═══════ -->
  <section id="classes" class="relative border-t border-white/5 px-6 py-32">
    <div class="mx-auto max-w-6xl">
      <div class="mb-16 text-center">
        <p class="mb-3 font-mono text-[11px] text-amber-500 uppercase tracking-[0.2em]">// horarios</p>
        <h2 class="text-5xl font-black tracking-tight sm:text-6xl">CLASES <span class="bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent">WEEKLY</span></h2>
        <p class="mt-4 text-sm text-white/40">Toca una clase para reservar por WhatsApp</p>
      </div>

      <!-- Day tabs -->
      <div class="mb-10 flex flex-wrap justify-center gap-2">
        {schedule.map((d, i) => (
          <button class={`day-tab rounded-xl border px-5 py-2.5 font-mono text-xs font-bold transition-all duration-300 ${i === 0 ? 'border-amber-500/50 bg-amber-500/10 text-amber-400' : 'border-white/10 text-white/40 hover:border-white/20 hover:text-white/70'}`} data-day={d.day}>
            {d.day}
          </button>
        ))}
      </div>

      <!-- Schedule grids -->
      {schedule.map((d, i) => (
        <div class={`schedule-grid ${i === 0 ? '' : 'hidden'}`} data-day={d.day}>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {d.items.map(cls => (
              <button
                class="class-item group flex items-center justify-between rounded-2xl border border-white/10 bg-white/[0.02] px-6 py-5 text-left transition-all duration-300 hover:-translate-y-1 hover:border-amber-500/30 hover:bg-amber-500/5 hover:shadow-lg hover:shadow-amber-500/5"
                data-day={d.day} data-time={cls.t} data-class={cls.n}
              >
                <div>
                  <div class="font-mono text-sm font-bold text-white transition-colors group-hover:text-amber-400">{cls.n}</div>
                  <div class="font-mono text-xs text-white/30">{cls.t} hs</div>
                </div>
                <div class="flex h-8 w-8 items-center justify-center rounded-full border border-white/10 text-white/30 transition-all duration-300 group-hover:border-amber-500/50 group-hover:bg-amber-500/10 group-hover:text-amber-400">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                </div>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════ BMI ═══════ -->
  <section id="bmi" class="relative border-t border-white/5 px-6 py-32">
    <div class="mx-auto max-w-4xl">
      <div class="mb-16 text-center">
        <p class="mb-3 font-mono text-[11px] text-amber-500 uppercase tracking-[0.2em]">// calculadora</p>
        <h2 class="text-5xl font-black tracking-tight sm:text-6xl">¿CUÁL ES TU <span class="bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent">IMC</span>?</h2>
      </div>

      <div class="grid gap-12 md:grid-cols-2">
        <div class="space-y-6">
          <div>
            <label class="mb-2 block font-mono text-xs text-white/40 uppercase tracking-wider">Peso (kg)</label>
            <input id="bmi-weight" type="number" value="70" min="30" max="250" class="w-full rounded-xl border border-white/10 bg-white/[0.03] px-5 py-4 font-mono text-lg text-white outline-none transition-all duration-300 focus:border-amber-500/50 focus:bg-white/[0.05]" />
          </div>
          <div>
            <label class="mb-2 block font-mono text-xs text-white/40 uppercase tracking-wider">Altura (cm)</label>
            <input id="bmi-height" type="number" value="170" min="100" max="250" class="w-full rounded-xl border border-white/10 bg-white/[0.03] px-5 py-4 font-mono text-lg text-white outline-none transition-all duration-300 focus:border-amber-500/50 focus:bg-white/[0.05]" />
          </div>
          <button id="bmi-btn" class="magnetic w-full rounded-xl bg-white py-4 font-mono text-sm font-bold text-black transition-all duration-300 hover:bg-white/90">CALCULAR IMC</button>
        </div>

        <div class="flex flex-col items-center justify-center rounded-3xl border border-white/10 bg-white/[0.02] p-10 text-center">
          <div class="font-mono text-8xl font-black text-white" id="bmi-value">--</div>
          <div class="mt-3 font-mono text-sm font-bold text-white/60" id="bmi-category">Ingresa tus datos</div>
          <div class="mt-2 max-w-xs text-xs text-white/30" id="bmi-desc">Completa peso y altura</div>
          <div class="mt-8 w-full">
            <div class="h-2 w-full overflow-hidden rounded-full bg-white/10">
              <div id="bmi-bar" class="h-full rounded-full bg-gradient-to-r from-amber-500 to-orange-500 transition-all duration-700" style="width:0%"></div>
            </div>
            <div class="mt-2 flex justify-between text-[10px] text-white/20 font-mono">
              <span>Bajo</span><span>Normal</span><span>Sobre</span><span>Obeso</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ TEAM ═══════ -->
  <section id="team" class="relative border-t border-white/5 px-6 py-32">
    <div class="mx-auto max-w-6xl">
      <div class="mb-16 text-center">
        <p class="mb-3 font-mono text-[11px] text-amber-500 uppercase tracking-[0.2em]">// staff</p>
        <h2 class="text-5xl font-black tracking-tight sm:text-6xl">NUESTROS <span class="bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent">ENTRENADORES</span></h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {trainers.map(t => (
          <div class="trainer-card group relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.02] p-6 text-center transition-all duration-500 hover:-translate-y-2 hover:border-amber-500/20 hover:shadow-2xl hover:shadow-amber-500/5">
            <div class="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-2xl bg-white/5 text-4xl transition-all duration-500 group-hover:scale-110 group-hover:bg-amber-500/10">
              {t.emoji}
            </div>
            <h3 class="font-mono text-sm font-bold text-white">{t.name}</h3>
            <p class="mt-1 text-xs text-amber-500">{t.role}</p>
            <p class="mt-1 font-mono text-[10px] text-white/30">{t.speciality}</p>
            <div class="mt-3 font-mono text-[10px] text-white/20">{t.exp}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ REVIEWS ═══════ -->
  <section class="relative border-t border-white/5 px-6 py-32 overflow-hidden">
    <div class="mx-auto max-w-5xl">
      <div class="mb-16 text-center">
        <p class="mb-3 font-mono text-[11px] text-amber-500 uppercase tracking-[0.2em]">// resultados</p>
        <h2 class="text-5xl font-black tracking-tight sm:text-6xl">HISTORIAS <span class="bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent">REALES</span></h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {reviews.map(rev => (
          <div class="review-card group rounded-3xl border border-white/10 bg-white/[0.02] p-7 transition-all duration-500 hover:-translate-y-1 hover:border-amber-500/20 hover:shadow-xl hover:shadow-amber-500/5">
            <div class="mb-4 flex gap-0.5">
              {Array.from({length: 5}, (_, j) => (
                <svg class={`h-4 w-4 ${j < rev.rating ? 'text-amber-500' : 'text-white/10'}`} fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="mb-5 text-sm leading-relaxed text-white/60">"{rev.text}"</p>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-white/5 font-mono text-xs font-bold text-white/60">{rev.name.charAt(0)}</div>
                <div>
                  <div class="text-xs font-bold text-white">{rev.name}</div>
                  <div class="font-mono text-[10px] text-white/30">Plan {rev.plan}</div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ FOOTER ═══════ -->
  <footer class="border-t border-white/5 px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-10 md:grid-cols-3">
        <div>
          <div class="flex items-center gap-3">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-amber-500 to-orange-600">
              <svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
            </div>
            <span class="font-mono text-sm font-bold text-white">RUPTURA FIT</span>
          </div>
          <p class="mt-3 text-xs text-white/30 leading-relaxed">{r.desc}</p>
        </div>
        <div>
          <h4 class="mb-4 font-mono text-[11px] text-white/50 uppercase tracking-widest">Horarios</h4>
          <p class="text-xs text-white/40">{r.schedule}</p>
          <p class="mt-1 text-xs text-white/40">{r.address}</p>
        </div>
        <div>
          <h4 class="mb-4 font-mono text-[11px] text-white/50 uppercase tracking-widest">Contacto</h4>
          <div class="flex gap-2">
            {[
              { href: `https://wa.me/${r.wa}`, label: 'WhatsApp', path: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z' },
              { href: `https://instagram.com/${r.ig.replace('@','')}`, label: 'Instagram', path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z' },
              { href: `https://facebook.com/${r.fb}`, label: 'Facebook', path: 'M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z' },
            ].map(s => (
              <a href={s.href} target="_blank" class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 text-white/40 transition-all duration-300 hover:border-white/20 hover:text-white hover:bg-white/5" aria-label={s.label}>
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d={s.path}/></svg>
              </a>
            ))}
          </div>
        </div>
      </div>
      <div class="mt-12 border-t border-white/5 pt-8 text-center">
        <p class="font-mono text-[10px] text-white/20">Demo — Hecho por <a href="https://cryfield.dev" target="_blank" class="text-amber-500/60 hover:text-amber-500 transition-colors">Cryfield.dev</a></p>
      </div>
    </div>
  </footer>

  <!-- Toast -->
  <div id="toast" class="fixed top-24 right-6 z-50 hidden translate-x-full overflow-hidden rounded-2xl border border-amber-500/20 bg-[#18181b]/95 px-5 py-3.5 shadow-2xl backdrop-blur-xl">
    <div class="flex items-center gap-3">
      <div class="flex h-7 w-7 items-center justify-center rounded-full bg-amber-500/10">
        <svg class="h-4 w-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <p id="toast-msg" class="font-mono text-sm text-white"></p>
    </div>
  </div>

  <!-- Scroll top -->
  <button id="scroll-top" class="fixed bottom-6 right-6 z-40 hidden h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-[#18181b]/90 shadow-xl backdrop-blur-xl transition-all duration-500 hover:border-white/20 hover:bg-white/5 hover:-translate-y-1 text-white/40 hover:text-white">
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m0 0l-7 7m7-7l7 7"/></svg>
  </button>
</body>
</html>

<style>
  @keyframes scrollBounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }
  .scroll-indicator { animation: scrollBounce 1.5s ease-in-out infinite; }

  input[type=number]::-webkit-inner-spin-button, input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  input[type=number] { -moz-appearance: textfield; }

  #scroll-top.show { display: flex; }
</style>

<script>
  import { animate, stagger } from 'animejs'

  const PAY_METHODS = {
    usd: ['Zelle', 'USD', 'USDT', 'PayPal'],
    bs: ['Pago movil', 'Transferencia'],
  }

  const state = {
    apiRate: null,
    currency: 'usd',
    payment: null,
    billing: 'one-time',
    selectedPlan: plans[0].id,
  }

  // Fetch dolarapi
  async function fetchRate() {
    try {
      const res = await fetch('https://ve.dolarapi.com/v1/dolares/oficial')
      const data = await res.json()
      state.apiRate = data.promedio
      updatePrices()
    } catch (e) { console.warn('Failed to fetch rate') }
  }

  function getRate() {
    if (state.currency === 'usd') return 1
    return state.apiRate || 1
  }

  function formatPrice(val) {
    if (state.currency === 'usd') return '$' + val.toFixed(2)
    return 'Bs.' + val.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
  }

  // Hero entrance
  animate('.hero-el', {
    y: [30, 0],
    opacity: [0, 1],
    duration: 800,
    ease: 'outExpo',
    delay: stagger(100, { start: 200 })
  })

  // Stat counters
  const heroStats = document.querySelectorAll('.hero-stat')
  let statsDone = false
  const statsObs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !statsDone) {
        statsDone = true
        heroStats.forEach(el => {
          const target = parseFloat(el.dataset.target)
          const suffix = el.dataset.suffix || ''
          const isDecimal = el.dataset.decimal === 'true'
          animate(el, {
            textContent: [0, target],
            duration: 2000,
            ease: 'outExpo',
            round: isDecimal ? 10 : 1,
            onUpdate: anim => {
              const val = isDecimal ? parseFloat(anim.textContent).toFixed(1) : Math.round(anim.textContent)
              el.textContent = val + suffix
            }
          })
        })
      }
    })
  }, { threshold: 0.5 })
  heroStats.forEach(el => statsObs.observe(el))

  // Scroll indicator
  const scrollTopBtn = document.getElementById('scroll-top')
  window.addEventListener('scroll', () => {
    scrollTopBtn.classList.toggle('show', window.scrollY > 400)
    scrollTopBtn.classList.toggle('hidden', window.scrollY <= 400)
  })
  scrollTopBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))

  // Magnetic buttons
  document.querySelectorAll('.magnetic').forEach(btn => {
    btn.addEventListener('mousemove', e => {
      const rect = btn.getBoundingClientRect()
      const x = (e.clientX - rect.left - rect.width / 2) * 0.15
      const y = (e.clientY - rect.top - rect.height / 2) * 0.15
      animate(btn, { x, y, duration: 200, ease: 'outQuad' })
    })
    btn.addEventListener('mouseleave', () => {
      animate(btn, { x: 0, y: 0, duration: 400, ease: 'outElastic(1, .4)' })
    })
  })

  // Toast
  const toast = document.getElementById('toast')
  const toastMsg = document.getElementById('toast-msg')
  function showToast(msg) {
    toastMsg.textContent = msg
    toast.classList.remove('hidden')
    animate(toast, { x: [100, 0], opacity: [0, 1], duration: 300, ease: 'outExpo' })
    setTimeout(() => {
      animate(toast, { x: [0, 100], opacity: [1, 0], duration: 250, ease: 'inExpo', onComplete: () => toast.classList.add('hidden') })
    }, 2000)
  }

  // Modal
  let activeTrap = null
  function trapFocus(el) {
    const f = el.querySelectorAll('button, [href], input, [tabindex]:not([tabindex="-1"])')
    const first = f[0], last = f[f.length - 1]
    function handler(e) {
      if (e.key !== 'Tab') return
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus() }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus() }
    }
    activeTrap = { handler }
    document.addEventListener('keydown', handler)
    if (first) first.focus()
  }
  function releaseTrap() { if (activeTrap) { document.removeEventListener('keydown', activeTrap.handler); activeTrap = null } }

  const modal = document.getElementById('modal')
  const mImg = document.getElementById('modal-img')
  const mName = document.getElementById('modal-name')
  const mBadge = document.getElementById('modal-badge')
  const mFeatures = document.getElementById('modal-features')
  const mPrice = document.getElementById('modal-price')
  const mCta = document.getElementById('modal-cta')

  function openModal(card) {
    const plan = plans.find(p => p.id === card.dataset.plan)
    if (!plan) return
    mImg.src = plan.img
    mImg.alt = plan.name
    mName.textContent = plan.name
    mBadge.textContent = plan.badge || 'Plan ' + plan.name
    mBadge.style.display = plan.badge ? '' : 'none'
    mFeatures.innerHTML = plan.features.map(f => `<li class="flex items-center gap-2 text-sm text-white/60"><svg class="h-4 w-4 flex-shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>${f}</li>`).join('')
    const price = state.billing === 'one-time' ? plan.price : plan.perMonth
    mPrice.textContent = formatPrice(price * getRate())
    const period = state.billing === 'one-time' ? 'pago unico' : 'por mes'
    mCta.href = `https://wa.me/584200000000?text=${encodeURIComponent('Hola! Quiero inscribirme en el plan ' + plan.name + ' (' + period + ')')}`
    modal.classList.remove('hidden')
    modal.classList.add('flex')
    animate(modal.querySelector('.modal-card'), { scale: [0.95, 1], opacity: [0, 1], duration: 250, ease: 'outExpo' })
    trapFocus(modal)
  }
  function closeModal() { releaseTrap(); modal.classList.add('hidden'); modal.classList.remove('flex') }

  document.getElementById('modal-close').addEventListener('click', closeModal)
  modal.addEventListener('click', e => { if (e.target === modal) closeModal() })

  // Plan selection
  document.querySelectorAll('.plan-card').forEach(card => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.plan-card').forEach(c => c.classList.remove('ring-1', 'ring-amber-500/30'))
      card.classList.add('ring-1', 'ring-amber-500/30')
      state.selectedPlan = card.dataset.plan
    })
    card.addEventListener('dblclick', () => openModal(card))
  })

  document.querySelectorAll('.plan-select-btn').forEach((btn, i) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.plan-card').forEach(c => c.classList.remove('ring-1', 'ring-amber-500/30'))
      document.querySelectorAll('.plan-card')[i].classList.add('ring-1', 'ring-amber-500/30')
      state.selectedPlan = plans[i].id
      openModal(document.querySelectorAll('.plan-card')[i])
    })
  })

  // Billing
  document.querySelectorAll('.billing-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.billing-btn').forEach(b => {
        b.classList.remove('bg-white', 'text-black')
        b.classList.add('text-white/50')
      })
      btn.classList.add('bg-white', 'text-black')
      btn.classList.remove('text-white/50')
      state.billing = btn.dataset.period
      updatePrices()
    })
  })

  // Currency
  document.querySelectorAll('.curr-opt').forEach(label => {
    const radio = label.querySelector('input')
    radio.addEventListener('change', () => {
      if (!radio.checked) return
      state.currency = radio.value
      state.payment = null
      updatePrices()
      renderPayMethods()
    })
  })

  function renderPayMethods() {
    const el = document.getElementById('pay-methods')
    const methods = PAY_METHODS[state.currency] || []
    el.innerHTML = methods.map(m => `<label class="pay-opt cursor-pointer rounded-lg border border-white/10 px-3 py-1.5 font-mono text-[10px] text-white/40 transition-all duration-300 has-[:checked]:border-amber-500/50 has-[:checked]:bg-amber-500/10 has-[:checked]:text-amber-400"><input type="radio" name="payment" value="${m}" class="hidden"> ${m}</label>`).join('')
  }

  function updatePrices() {
    const rate = getRate()
    document.querySelectorAll('.plan-card').forEach((card, i) => {
      const plan = plans[i]
      const price = state.billing === 'one-time' ? plan.price : plan.perMonth
      card.querySelector('.plan-price').textContent = formatPrice(price * rate)
      card.querySelector('.plan-period').textContent = state.billing === 'one-time' ? 'pago unico' : plan.perMonth + ' USD/mes'
    })
  }

  // Plan CTA
  document.getElementById('plan-cta').addEventListener('click', () => {
    const plan = plans.find(p => p.id === state.selectedPlan) || plans[0]
    const price = state.billing === 'one-time' ? plan.price : plan.perMonth
    const period = state.billing === 'one-time' ? 'pago unico' : 'por mes'
    const msg = `Hola! Quiero inscribirme en el plan ${plan.name} (${period}) por ${formatPrice(price * getRate())}${state.payment ? ' - ' + state.payment : ''}`
    window.open(`https://wa.me/584200000000?text=${encodeURIComponent(msg)}`, '_blank')
    showToast('Inscribiendote en ' + plan.name)
  })

  // Schedule tabs
  document.querySelectorAll('.day-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.day-tab').forEach(t => {
        t.classList.remove('border-amber-500/50', 'bg-amber-500/10', 'text-amber-400')
        t.classList.add('border-white/10', 'text-white/40')
      })
      tab.classList.add('border-amber-500/50', 'bg-amber-500/10', 'text-amber-400')
      tab.classList.remove('border-white/10', 'text-white/40')
      document.querySelectorAll('.schedule-grid').forEach(g => g.classList.add('hidden'))
      const target = document.querySelector(`.schedule-grid[data-day="${tab.dataset.day}"]`)
      if (target) {
        target.classList.remove('hidden')
        animate(target.querySelectorAll('.class-item'), {
          y: [12, 0], opacity: [0, 1], duration: 350, ease: 'outExpo', delay: stagger(40)
        })
      }
    })
  })

  // Class click
  document.querySelectorAll('.class-item').forEach(btn => {
    btn.addEventListener('click', () => {
      const msg = `Hola! Quiero apartar cupo para ${btn.dataset.class} el ${btn.dataset.day} a las ${btn.dataset.time}`
      window.open(`https://wa.me/584200000000?text=${encodeURIComponent(msg)}`, '_blank')
      showToast(`${btn.dataset.class} — ${btn.dataset.time}`)
    })
  })

  // BMI
  function calcBmi() {
    const w = parseFloat(document.getElementById('bmi-weight').value)
    const h = parseFloat(document.getElementById('bmi-height').value) / 100
    if (!w || !h || h <= 0) return
    const bmi = w / (h * h)
    animate(document.getElementById('bmi-value'), { textContent: [0, bmi], duration: 1000, ease: 'outExpo', round: 10 })
    let cat, desc, pct
    if (bmi < 18.5) { cat = 'Bajo peso'; desc = 'Te recomendamos el plan con nutricionista'; pct = 25 }
    else if (bmi < 25) { cat = 'Normal'; desc = 'Peso saludable. Mantenelo con entrenamiento'; pct = 50 }
    else if (bmi < 30) { cat = 'Sobrepeso'; desc = 'El plan Trimestral es ideal para vos'; pct = 75 }
    else { cat = 'Obesidad'; desc = 'Plan Anual con seguimiento personalizado'; pct = 100 }
    document.getElementById('bmi-category').textContent = cat
    document.getElementById('bmi-desc').textContent = desc
    animate(document.getElementById('bmi-bar'), { width: [0, pct + '%'], duration: 800, ease: 'outExpo' })
  }
  document.getElementById('bmi-btn').addEventListener('click', calcBmi)
  document.getElementById('bmi-weight').addEventListener('input', calcBmi)
  document.getElementById('bmi-height').addEventListener('input', calcBmi)
  calcBmi()

  // Init
  fetchRate().finally(() => { updatePrices() })
  renderPayMethods()
